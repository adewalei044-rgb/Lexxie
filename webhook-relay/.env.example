# Copy this file to .env and fill in your own values. Never commit .env.

# Port the relay listens on internally (Nginx proxies HTTPS to this)
PORT=3000

# Long random string - put this in your TradingView Webhook URL as
# https://your-domain/hook/<this-value>. Generate one with:
#   openssl rand -hex 24
WEBHOOK_SECRET=

# Bybit API key/secret - create with TRADE permission only, NO withdrawal
# permission, and IP-whitelist it to this VPS's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Set to "true" to hit Bybit's testnet instead of live trading. Start here.
BYBIT_TESTNET=true

# linear = USDT perpetual futures (default). Use "spot" for spot trading.
BYBIT_CATEGORY=linear

# --- Position sizing (pick ONE approach) ---

# Option A: risk a fixed USDT amount per trade; qty is derived from the
# entry price and stop price the Lexxie script sends in the webhook.
RISK_USDT=0

# Option B: always trade a fixed quantity regardless of stop distance.
# Used only if RISK_USDT is 0.
FIXED_QTY=0.001

# Bybit's minimum order-size increment for your symbol (check the
# "Instrument Info" / contract details on Bybit for the exact step,
# e.g. 0.001 for BTCUSDT). Quantities are rounded down to this step.
QTY_STEP=0.001
