//@version=6
strategy("Lexxie - Debug Entry Signals (Engulfing / Signal Bar / Key Bar)",
     shorttitle = "Lexxie Debug Entries",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10,
     commission_type = strategy.commission.percent,
     commission_value = 0.02,
     calc_on_every_tick = true,
     process_orders_on_close = true,
     max_bars_back = 500)

// NOTE ON REPAINTING: calc_on_every_tick is true so the stats table and plots update live,
// tick by tick. Repainting is still prevented at the signal level: every pattern/order below
// is separately gated on barstate.isconfirmed, so trades and pattern markers only fire once,
// on the confirmed close of a bar, and never move or disappear afterward.

// =====================================================================================
// INPUTS
// =====================================================================================

grpSignals   = "Entry Signal Types (choose which patterns can trigger trades)"
useEngulfing = input.bool(true,  "Trade Engulfing Candle",        group = grpSignals)
useSignalBar = input.bool(false, "Trade Signal Bar (Pin Bar)",    group = grpSignals,
     tooltip = "Off by default - pin bars are the noisiest of the three patterns on a 1-minute chart. Test it on its own before stacking it with the others.")
useKeyBar    = input.bool(true,  "Trade Key Bar (Momentum Bar)",  group = grpSignals)
useDemandSupply  = input.bool(false, "Trade Demand/Supply Zones", group = grpSignals,
     tooltip = "Enters when price first touches an active zone (uses the thresholds/colors from the Demand/Supply Zones group below).")
useRsiDivergence = input.bool(false, "Trade RSI Divergence", group = grpSignals,
     tooltip = "Enters on a confirmed bullish/bearish RSI divergence (uses the settings from the RSI group below).")
useRsiLevels     = input.bool(false, "Trade Normal RSI Levels", group = grpSignals,
     tooltip = "Long when RSI crosses into oversold, short when RSI crosses into overbought (uses the levels from the RSI group below).")
allowLongs   = input.bool(true,  "Allow Long (Buy) Entries",      group = grpSignals)
allowShorts  = input.bool(true,  "Allow Short (Sell) Entries",    group = grpSignals)

grpCombo = "Combo (Confluence) - either/or with Entry Signal Types above, never both"
comboEnable = input.bool(false, "Enable Combo Signal", group = grpCombo,
     tooltip = "This is a mode switch, not an add-on. ON: only Combo can trigger trades - the Entry Signal Types list above is ignored for trading (its checkboxes still just drive the debug plots). OFF: only the Entry Signal Types list above can trigger trades, Combo is fully inactive. Tick 2 or more boxes below and, while Combo is ON, a trade only fires once ALL of the ticked ones have agreed (same direction) within the confluence window below.")
comboWindowBars       = input.int(5, "Confluence Window (bars)", minval = 1, maxval = 50, group = grpCombo,
     tooltip = "Each ticked signal just needs to have fired within this many bars of each other, not all on the exact same candle - requiring the exact same bar makes Combo fire extremely rarely, or never.")
comboUseRsiLevels     = input.bool(false, "Combo: RSI Level (OB/OS)",     group = grpCombo)
comboUseRsiDivergence = input.bool(false, "Combo: RSI Divergence",       group = grpCombo)
comboUseSignalBar     = input.bool(false, "Combo: Pin Bar (Signal Bar)", group = grpCombo)
comboUseEngulfing     = input.bool(false, "Combo: Engulfing Candle",     group = grpCombo)
comboUseKeyBar        = input.bool(false, "Combo: Key Bar",              group = grpCombo)
comboUseDemandSupply  = input.bool(false, "Combo: Demand/Supply Zone",   group = grpCombo)

grpSession       = "Session Filter"
useSessionFilter = input.bool(false, "Only Trade During Session Hours", group = grpSession,
     tooltip = "Restricting entries to a liquid session window (e.g. market open) usually helps 1-minute signal quality more than tweaking pattern thresholds.")
sessionHours     = input.session("0930-1130", "Session (Exchange Time)", group = grpSession)

grpZones      = "Demand / Supply Zones"
showZones     = input.bool(false, "Show Demand/Supply Zones", group = grpZones,
     tooltip = "Draws a zone box on the base candle right before a strong breakout bar. Zones are still tracked internally for trading even if this is off - this only controls whether they're drawn.")
zoneRangeMult = input.float(1.5, "Zone Breakout Min Range vs ATR", minval = 1.0, step = 0.1, group = grpZones)
zoneMaxCount  = input.int(5, "Max Zones Shown (per side)", minval = 1, maxval = 20, group = grpZones)
demandColor   = input.color(color.new(color.green, 85), "Demand Zone Color", group = grpZones)
supplyColor   = input.color(color.new(color.red, 85),   "Supply Zone Color", group = grpZones)

grpRSI            = "RSI"
rsiLen            = input.int(14, "RSI Length", minval = 1, group = grpRSI)
showRsiLevels     = input.bool(false, "Show Normal RSI Overbought/Oversold Levels", group = grpRSI,
     tooltip = "Draws a marker on the bar where RSI crosses into overbought/oversold. Detection is still active for trading even if this is off - this only controls whether it's drawn.")
rsiOverbought     = input.int(70, "RSI Overbought Level", minval = 50, maxval = 100, group = grpRSI)
rsiOversold       = input.int(30, "RSI Oversold Level", minval = 0, maxval = 50, group = grpRSI)
showRsiDivergence = input.bool(false, "Show RSI Divergence", group = grpRSI,
     tooltip = "Draws the divergence marker on the chart. Divergence is still detected internally for trading even if this is off - this only controls whether it's drawn.")
rsiDivLeft        = input.int(5, "Divergence Pivot Left Bars", minval = 1, group = grpRSI)
rsiDivRight       = input.int(5, "Divergence Pivot Right Bars", minval = 1, group = grpRSI)

grpEngulf           = "Engulfing Candle Settings"
engulfMinBodyRatio  = input.float(1.3, "Min Body Size vs Prev Body", minval = 0.5, step = 0.1, group = grpEngulf,
     tooltip = "Current candle's body must be at least this many times the size of the previous candle's body")

grpSignalBar   = "Signal Bar (Pin Bar) Settings"
sigBarWickRatio = input.float(2.0, "Min Wick-to-Body Ratio", minval = 1.0, step = 0.1, group = grpSignalBar,
     tooltip = "Rejection wick must be at least this many times the candle body")
sigBarLookback  = input.int(5, "Prior Trend Lookback (bars)", minval = 1, maxval = 400, group = grpSignalBar,
     tooltip = "Number of bars used to confirm a prior directional move before the signal bar")

grpKeyBar        = "Key Bar (Momentum Bar) Settings"
keyBarAtrLen     = input.int(14, "ATR Length", minval = 1, group = grpKeyBar)
keyBarRangeMult  = input.float(1.8, "Min Bar Range vs ATR", minval = 1.0, step = 0.1, group = grpKeyBar)
keyBarCloseLoc   = input.float(0.20, "Max Close Distance From Extreme (% of range)", minval = 0.05, maxval = 0.5, step = 0.05, group = grpKeyBar,
     tooltip = "How close the close must be to the bar's high (bullish) or low (bearish)")

grpTrade    = "Trade Management"
slType      = input.string("ATR", "Stop Loss Type", options = ["ATR", "Points", "Percent"], group = grpTrade)
slAtrLen    = input.int(14, "SL ATR Length", minval = 1, group = grpTrade)
slAtrMult   = input.float(1.1, "SL ATR Multiplier", minval = 0.1, step = 0.1, group = grpTrade)
slPoints    = input.float(10, "SL Points", minval = 0.0001, group = grpTrade)
slPercent   = input.float(0.5, "SL Percent", minval = 0.01, step = 0.05, group = grpTrade)
rrRatio     = input.float(1.5, "Risk : Reward (1 : X)", minval = 0.1, step = 0.1, group = grpTrade,
     tooltip = "Take-profit distance = Stop-loss distance x this value. 1.5 = risking 1 to make 1.5. Raise toward 2.0 once you've confirmed the win rate holds up in the Strategy Tester.")

grpDebug   = "Debug Mode"
debugMode  = input.bool(true, "Enable Debug Mode (plot every detected pattern, even if not tradeable)", group = grpDebug)

grpLabels    = "Buy / Sell Entry Labels"
showLabels   = input.bool(true, "Show Buy/Sell Entry Labels", group = grpLabels)
buyColor     = input.color(color.new(color.green, 0), "Buy Label Color", group = grpLabels)
sellColor    = input.color(color.new(color.red, 0),   "Sell Label Color", group = grpLabels)
labelTextSize = input.string(size.tiny, "Buy/Sell Label Size",
     options = [size.tiny, size.small, size.normal, size.large], group = grpLabels)

grpSLTP       = "Entry / TP / SL Lines / Zone Box"
showSLTPLines = input.bool(true, "Show Entry/TP/SL Lines", group = grpSLTP,
     tooltip = "Entry, TP, and SL lines and tags for the open trade, aligned with the zone box's edges (TP = top of green zone, SL = bottom of red zone, Entry = the boundary between them).")
showSLTPZones = input.bool(true, "Show Profit/Loss Zone Boxes", group = grpSLTP,
     tooltip = "Independent of the lines above - shows/hides the shaded green (profit) and red (loss) zone boxes between entry and TP/SL.")
slLineColor   = input.color(color.new(color.red, 0),  "SL Line / Loss Zone Color", group = grpSLTP)
tpLineColor   = input.color(color.new(color.teal, 0), "TP Line / Profit Zone Color", group = grpSLTP)

grpWebhook       = "Webhook / Alerts"
useWebhookAlerts = input.bool(false, "Fire alert() on entries (for webhook automation)", group = grpWebhook,
     tooltip = "Pine Script cannot POST to a URL by itself. This only fires the alert() event inside the script - you still need to create a TradingView Alert on this script (Condition: 'Any alert() function call', or 'Order fills' for entries+exits) and paste your endpoint under Notifications -> Webhook URL.")

grp3Commas   = "3Commas Webhook Format (optional)"
use3Commas   = input.bool(false, "Format alert_message for 3Commas", group = grp3Commas,
     tooltip = "ON: every alert_message is built in 3Commas' TradingView Custom Signal JSON format instead of the plain one above, so you can paste your 3Commas webhook URL straight into the TradingView alert with no separate relay server needed. OFF: uses the plain {symbol, action, price, stop, target, pattern, time} format, meant for the self-hosted relay in this repo. Use Alert Condition = 'Order fills' with this on, not 'Any alert() function call' - the {{strategy.*}} placeholders below only resolve correctly on real order fills.")
three3Secret  = input.string("", "3Commas Secret", group = grp3Commas,
     tooltip = "The long token from the \"secret\" field 3Commas shows on the bot's TradingView webhook setup page.")
three3BotUuid = input.string("", "3Commas Bot UUID", group = grp3Commas,
     tooltip = "The \"bot_uuid\" value from the same 3Commas webhook setup page.")
three3MaxLag  = input.string("300", "Max Lag (seconds)", group = grp3Commas,
     tooltip = "The \"max_lag\" value 3Commas suggests on the webhook setup page - how stale (in seconds) a signal can be before 3Commas ignores it. 300 is their usual default.")

grpTable       = "Stats Table"
showTable      = input.bool(true, "Show Stats Table", group = grpTable)
tablePos       = input.string(position.top_right, "Table Position",
     options = [position.top_right, position.top_left, position.bottom_right, position.bottom_left], group = grpTable)
tableTextSize  = input.string(size.small, "Table Text Size",
     options = [size.tiny, size.small, size.normal, size.large], group = grpTable)

// =====================================================================================
// PATTERN DETECTION
// =====================================================================================

// Only true once a bar has fully closed - blocks every signal/plot/order below from
// reacting to an in-progress, still-changing realtime bar (no repainting).
barConfirmed = barstate.isconfirmed

// --- Engulfing candle ---
bullishEngulf = close[1] < open[1] and close > open and close > open[1] and open <= close[1] and
     (close - open) >= (open[1] - close[1]) * engulfMinBodyRatio
bearishEngulf = close[1] > open[1] and close < open and close < open[1] and open >= close[1] and
     (open - close) >= (close[1] - open[1]) * engulfMinBodyRatio

// --- Signal bar (pin bar / rejection bar) ---
body        = math.abs(close - open)
upperWick   = high - math.max(close, open)
lowerWick   = math.min(close, open) - low
priorDowntrend = close[1] < close[1 + sigBarLookback]
priorUptrend   = close[1] > close[1 + sigBarLookback]

bullishSignalBar = body > 0 and lowerWick >= body * sigBarWickRatio and lowerWick > upperWick and priorDowntrend
bearishSignalBar = body > 0 and upperWick >= body * sigBarWickRatio and upperWick > lowerWick and priorUptrend

// --- Key bar (momentum / breakout bar) ---
atrKey       = ta.atr(keyBarAtrLen)
barRange     = high - low
closeLocBull = barRange > 0 ? (high - close) / barRange : 1.0
closeLocBear = barRange > 0 ? (close - low) / barRange : 1.0

bullishKeyBar = barRange >= atrKey * keyBarRangeMult and close > open and closeLocBull <= keyBarCloseLoc
bearishKeyBar = barRange >= atrKey * keyBarRangeMult and close < open and closeLocBear <= keyBarCloseLoc

// =====================================================================================
// DEMAND / SUPPLY ZONES - tracked internally for trading; showZones only controls drawing
// =====================================================================================

var array<box> demandZones = array.new<box>()
var array<box> supplyZones = array.new<box>()

demandDrawColor   = showZones ? demandColor : color.new(demandColor, 100)
supplyDrawColor   = showZones ? supplyColor : color.new(supplyColor, 100)
demandBorderColor = showZones ? color.new(color.green, 40) : color.new(color.green, 100)
supplyBorderColor = showZones ? color.new(color.red, 40)   : color.new(color.red, 100)

zonesActive = showZones or useDemandSupply

strongBullMove = barConfirmed and barRange >= atrKey * zoneRangeMult and close > open
strongBearMove = barConfirmed and barRange >= atrKey * zoneRangeMult and close < open

if zonesActive and strongBullMove
    demandBox = box.new(left = bar_index - 1, top = high[1], bottom = low[1], right = bar_index,
         bgcolor = demandDrawColor, border_color = demandBorderColor, extend = extend.none)
    array.push(demandZones, demandBox)
    if array.size(demandZones) > zoneMaxCount
        box.delete(array.shift(demandZones))

if zonesActive and strongBearMove
    supplyBox = box.new(left = bar_index - 1, top = high[1], bottom = low[1], right = bar_index,
         bgcolor = supplyDrawColor, border_color = supplyBorderColor, extend = extend.none)
    array.push(supplyZones, supplyBox)
    if array.size(supplyZones) > zoneMaxCount
        box.delete(array.shift(supplyZones))

if zonesActive and barConfirmed
    if array.size(demandZones) > 0
        for i = array.size(demandZones) - 1 to 0
            zBox = array.get(demandZones, i)
            if close < box.get_bottom(zBox)
                box.delete(zBox)
                array.remove(demandZones, i)
            else
                box.set_right(zBox, bar_index)
    if array.size(supplyZones) > 0
        for i = array.size(supplyZones) - 1 to 0
            zBox = array.get(supplyZones, i)
            if close > box.get_top(zBox)
                box.delete(zBox)
                array.remove(supplyZones, i)
            else
                box.set_right(zBox, bar_index)

// Zone-touch detection for trading - fires once when price first enters a zone
inDemandZone = false
if array.size(demandZones) > 0
    for i = 0 to array.size(demandZones) - 1
        zBox = array.get(demandZones, i)
        if close <= box.get_top(zBox) and close >= box.get_bottom(zBox)
            inDemandZone := true

inSupplyZone = false
if array.size(supplyZones) > 0
    for i = 0 to array.size(supplyZones) - 1
        zBox = array.get(supplyZones, i)
        if close <= box.get_top(zBox) and close >= box.get_bottom(zBox)
            inSupplyZone := true

var bool prevInDemandZone = false
var bool prevInSupplyZone = false

enterDemandZone = barConfirmed and inDemandZone and not prevInDemandZone
enterSupplyZone = barConfirmed and inSupplyZone and not prevInSupplyZone

// Only latch the "previous" state once a bar is confirmed - otherwise, with
// calc_on_every_tick=true, this would get overwritten by the current bar's own
// in-progress ticks before it closes, comparing the bar to itself instead of
// to the true prior confirmed bar.
if barConfirmed
    prevInDemandZone := inDemandZone
    prevInSupplyZone := inSupplyZone

// =====================================================================================
// RSI - overbought/oversold levels + divergence, tracked internally for trading;
// showRsiLevels/showRsiDivergence only control drawing
// =====================================================================================

rsiValue = ta.rsi(close, rsiLen)

enterOverbought = ta.crossover(rsiValue, rsiOverbought)
enterOversold   = ta.crossunder(rsiValue, rsiOversold)

plotshape(showRsiLevels and enterOverbought and barConfirmed, title = "RSI Overbought", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),   size = size.tiny, text = "OB")
plotshape(showRsiLevels and enterOversold   and barConfirmed, title = "RSI Oversold",   style = shape.triangleup,   location = location.belowbar, color = color.new(color.green, 0), size = size.tiny, text = "OS")

rsiPivotLow  = ta.pivotlow(rsiValue, rsiDivLeft, rsiDivRight)
rsiPivotHigh = ta.pivothigh(rsiValue, rsiDivLeft, rsiDivRight)

var float prevRsiPL   = na
var float prevPricePL = na
var float prevRsiPH   = na
var float prevPricePH = na

bullishRsiDiv = false
bearishRsiDiv = false

if barConfirmed and not na(rsiPivotLow)
    priceAtPL = low[rsiDivRight]
    if not na(prevRsiPL) and priceAtPL < prevPricePL and rsiPivotLow > prevRsiPL
        bullishRsiDiv := true
    prevRsiPL   := rsiPivotLow
    prevPricePL := priceAtPL

if barConfirmed and not na(rsiPivotHigh)
    priceAtPH = high[rsiDivRight]
    if not na(prevRsiPH) and priceAtPH > prevPricePH and rsiPivotHigh < prevRsiPH
        bearishRsiDiv := true
    prevRsiPH   := rsiPivotHigh
    prevPricePH := priceAtPH

plotshape(showRsiDivergence and bullishRsiDiv, title = "Bullish RSI Divergence", style = shape.labelup,   location = location.belowbar, color = color.new(color.blue, 0),   textcolor = color.white, text = "Bull Div", size = size.small, offset = -rsiDivRight)
plotshape(showRsiDivergence and bearishRsiDiv, title = "Bearish RSI Divergence", style = shape.labeldown, location = location.abovebar, color = color.new(color.purple, 0), textcolor = color.white, text = "Bear Div", size = size.small, offset = -rsiDivRight)

// =====================================================================================
// SIGNAL COMBINATION
// =====================================================================================

longSignalCount = (useEngulfing and bullishEngulf ? 1 : 0) + (useSignalBar and bullishSignalBar ? 1 : 0) + (useKeyBar and bullishKeyBar ? 1 : 0) + (useDemandSupply and enterDemandZone ? 1 : 0) + (useRsiDivergence and bullishRsiDiv ? 1 : 0) + (useRsiLevels and enterOversold ? 1 : 0)
shortSignalCount = (useEngulfing and bearishEngulf ? 1 : 0) + (useSignalBar and bearishSignalBar ? 1 : 0) + (useKeyBar and bearishKeyBar ? 1 : 0) + (useDemandSupply and enterSupplyZone ? 1 : 0) + (useRsiDivergence and bearishRsiDiv ? 1 : 0) + (useRsiLevels and enterOverbought ? 1 : 0)

// --- Combo (Confluence) - a fully separate checklist; every ticked box must agree within
// comboWindowBars of each other. Requiring the exact same candle (the original design) made
// this fire extremely rarely, since independent patterns almost never coincide on one bar.
f_recentlyTrue(cond) =>
    sinceTrue = ta.barssince(cond)
    not na(sinceTrue) and sinceTrue <= comboWindowBars

comboTickedCount = (comboUseRsiLevels ? 1 : 0) + (comboUseRsiDivergence ? 1 : 0) + (comboUseSignalBar ? 1 : 0) + (comboUseEngulfing ? 1 : 0) + (comboUseKeyBar ? 1 : 0) + (comboUseDemandSupply ? 1 : 0)

comboLongAllAgree  = (not comboUseRsiLevels     or f_recentlyTrue(enterOversold))     and (not comboUseRsiDivergence or f_recentlyTrue(bullishRsiDiv)) and
     (not comboUseSignalBar or f_recentlyTrue(bullishSignalBar)) and (not comboUseEngulfing or f_recentlyTrue(bullishEngulf)) and
     (not comboUseKeyBar    or f_recentlyTrue(bullishKeyBar))    and (not comboUseDemandSupply or f_recentlyTrue(enterDemandZone))
comboShortAllAgree = (not comboUseRsiLevels     or f_recentlyTrue(enterOverbought))   and (not comboUseRsiDivergence or f_recentlyTrue(bearishRsiDiv)) and
     (not comboUseSignalBar or f_recentlyTrue(bearishSignalBar)) and (not comboUseEngulfing or f_recentlyTrue(bearishEngulf)) and
     (not comboUseKeyBar    or f_recentlyTrue(bearishKeyBar))    and (not comboUseDemandSupply or f_recentlyTrue(enterSupplyZone))

// Only fire once per confluence, on the bar where the LAST ticked signal actually fires -
// otherwise comboLongAllAgree would stay true for comboWindowBars bars in a row and could
// fire repeatedly right after a position closes.
comboLongTrigger  = (comboUseRsiLevels     and enterOversold)     or (comboUseRsiDivergence and bullishRsiDiv) or
     (comboUseSignalBar and bullishSignalBar) or (comboUseEngulfing and bullishEngulf) or
     (comboUseKeyBar    and bullishKeyBar)    or (comboUseDemandSupply and enterDemandZone)
comboShortTrigger = (comboUseRsiLevels     and enterOverbought)   or (comboUseRsiDivergence and bearishRsiDiv) or
     (comboUseSignalBar and bearishSignalBar) or (comboUseEngulfing and bearishEngulf) or
     (comboUseKeyBar    and bearishKeyBar)    or (comboUseDemandSupply and enterSupplyZone)

comboLongHit  = comboEnable and comboTickedCount >= 2 and comboLongAllAgree  and comboLongTrigger
comboShortHit = comboEnable and comboTickedCount >= 2 and comboShortAllAgree and comboShortTrigger

// Combo and the Entry Signal Types list are mutually exclusive, not merged - "Enable Combo
// Signal" is the mode switch. On: only Combo can trigger trades, the regular list is ignored
// for trading (its checkboxes still just drive the debug plots). Off: only the regular list
// can trigger trades, exactly as before.
longPatternHit  = comboEnable ? comboLongHit  : (longSignalCount  > 0)
shortPatternHit = comboEnable ? comboShortHit : (shortSignalCount > 0)

inSession  = not na(time(timeframe.period, sessionHours))
sessionOk  = not useSessionFilter or inSession

longSignal  = allowLongs  and longPatternHit  and barConfirmed and sessionOk
shortSignal = allowShorts and shortPatternHit and barConfirmed and sessionOk

f_buildSignalText(engulf, sigbar, keybar, zone, rsidiv, rsilvl, combo) =>
    txt = ""
    if engulf
        txt := txt + "Engulf"
    if sigbar
        txt := txt + (txt == "" ? "" : "+") + "SigBar"
    if keybar
        txt := txt + (txt == "" ? "" : "+") + "KeyBar"
    if zone
        txt := txt + (txt == "" ? "" : "+") + "Zone"
    if rsidiv
        txt := txt + (txt == "" ? "" : "+") + "RSIdiv"
    if rsilvl
        txt := txt + (txt == "" ? "" : "+") + "RSILvl"
    if combo
        txt := txt + (txt == "" ? "" : "+") + "Combo"
    txt

longSignalText  = f_buildSignalText(useEngulfing and bullishEngulf, useSignalBar and bullishSignalBar, useKeyBar and bullishKeyBar, useDemandSupply and enterDemandZone, useRsiDivergence and bullishRsiDiv, useRsiLevels and enterOversold, comboLongHit)
shortSignalText = f_buildSignalText(useEngulfing and bearishEngulf, useSignalBar and bearishSignalBar, useKeyBar and bearishKeyBar, useDemandSupply and enterSupplyZone, useRsiDivergence and bearishRsiDiv, useRsiLevels and enterOverbought, comboShortHit)

// =====================================================================================
// DEBUG PLOTS - shows every raw pattern detected, whether or not it's enabled for trading
// =====================================================================================

plotshape(debugMode and bullishEngulf    and barConfirmed, title = "Bull Engulf",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.lime,     0), size = size.tiny)
plotshape(debugMode and bearishEngulf    and barConfirmed, title = "Bear Engulf",  style = shape.triangledown, location = location.abovebar, color = color.new(color.red,     0), size = size.tiny)
plotshape(debugMode and bullishSignalBar and barConfirmed, title = "Bull SigBar",  style = shape.circle,        location = location.belowbar, color = color.new(color.aqua,    0), size = size.tiny)
plotshape(debugMode and bearishSignalBar and barConfirmed, title = "Bear SigBar",  style = shape.circle,        location = location.abovebar, color = color.new(color.orange,  0), size = size.tiny)
plotshape(debugMode and bullishKeyBar    and barConfirmed, title = "Bull KeyBar",  style = shape.square,         location = location.belowbar, color = color.new(color.yellow,  0), size = size.tiny)
plotshape(debugMode and bearishKeyBar    and barConfirmed, title = "Bear KeyBar",  style = shape.square,         location = location.abovebar, color = color.new(color.fuchsia, 0), size = size.tiny)

// =====================================================================================
// 3COMMAS WEBHOOK FORMAT - only used when use3Commas is on. This mirrors 3Commas'
// "TradingView Custom Signal" webhook template exactly (as shown on their bot's webhook
// setup page). Almost every field is a TradingView {{placeholder}} that gets substituted
// automatically when the alert fires on a real order fill, so the SAME static message
// works for every entry and exit - no need to build a different string per action.
// =====================================================================================

f_build3CommasMsg() =>
    '{"secret":"' + three3Secret + '","max_lag":"' + three3MaxLag + '","timestamp":"{{timenow}}",' +
     '"trigger_price":"{{close}}","tv_exchange":"{{exchange}}","tv_instrument":"{{ticker}}",' +
     '"action":"{{strategy.order.action}}","bot_uuid":"' + three3BotUuid + '","strategy_info":{' +
     '"market_position":"{{strategy.market_position}}","market_position_size":"{{strategy.market_position_size}}",' +
     '"prev_market_position":"{{strategy.prev_market_position}}","prev_market_position_size":"{{strategy.prev_market_position_size}}"},' +
     '"order":{"amount":"{{strategy.order.contracts}}","currency_type":"base"}}'

// =====================================================================================
// TRADE MANAGEMENT (Stop Loss / Take Profit)
// =====================================================================================

atrTrade = ta.atr(slAtrLen)

longSL = slType == "ATR" ? close - atrTrade * slAtrMult : slType == "Points" ? close - slPoints : close * (1 - slPercent / 100)
longRisk = close - longSL
longTP = close + longRisk * rrRatio

shortSL = slType == "ATR" ? close + atrTrade * slAtrMult : slType == "Points" ? close + slPoints : close * (1 + slPercent / 100)
shortRisk = shortSL - close
shortTP = close - shortRisk * rrRatio

// =====================================================================================
// ENTRIES + BUY / SELL LABELS + SL/TP LINES
// =====================================================================================

// Every trade keeps its own flag/tag/box - nothing is deleted. Trades never overlap in time
// (only one position open at once), so each box only ever spans its own trade's bars and
// stops extending the moment that trade closes, which keeps the chart clean without having
// to erase history. Only the current OPEN trade's lines/tags/box keep moving forward.
// Entry/TP/SL lines all align with the box: TP = top of the green zone, Entry = the
// boundary between green and red, SL = bottom of the red zone.
var line  curTPLine      = na
var line  curEntryLine   = na
var line  curSLLine      = na
var label curTPLabel     = na
var label curEntryLabel  = na
var label curSLLabel     = na
var box   curProfitBox   = na
var box   curLossBox     = na

profitBoxColor  = color.new(tpLineColor, 85)
lossBoxColor    = color.new(slLineColor, 85)
infoColor       = color.new(color.white, 100)
entryLineColor  = color.new(color.blue, 0)

if longSignal and strategy.position_size <= 0 and longRisk > 0
    longAlertMsg = use3Commas ? f_build3CommasMsg() :
         '{"strategy":"Lexxie Debug Entries","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period +
         '","action":"buy","price":' + str.tostring(close) + ',"stop":' + str.tostring(longSL) + ',"target":' + str.tostring(longTP) +
         ',"pattern":"' + longSignalText + '","time":"' + str.tostring(time) + '"}'
    longCloseMsg = use3Commas ? f_build3CommasMsg() :
         '{"strategy":"Lexxie Debug Entries","symbol":"' + syminfo.ticker + '","action":"close_long","price":{{strategy.order.price}},"time":"{{time}}"}'
    strategy.entry("Long", strategy.long, alert_message = longAlertMsg)
    strategy.exit("Long Exit", "Long", stop = longSL, limit = longTP, alert_message = longCloseMsg)
    if showLabels
        label.new(bar_index, low, "Buy", style = label.style_label_up, color = buyColor, textcolor = color.white, size = labelTextSize)
        label.new(bar_index, low - atrTrade * 0.6, "LE\n" + str.tostring(close, format.mintick), style = label.style_label_up,
             color = infoColor, textcolor = color.gray, size = size.tiny)
    if useWebhookAlerts
        alert(longAlertMsg, alert.freq_once_per_bar_close)
    if showSLTPLines
        curTPLine     := line.new(bar_index, longTP, bar_index, longTP, color = tpLineColor,    style = line.style_dashed, width = 1)
        curEntryLine  := line.new(bar_index, close,  bar_index, close,  color = entryLineColor,  style = line.style_dashed, width = 1)
        curSLLine     := line.new(bar_index, longSL, bar_index, longSL, color = slLineColor,     style = line.style_dashed, width = 1)
        curTPLabel    := label.new(bar_index, longTP, "TP",    style = label.style_label_left, color = tpLineColor,    textcolor = color.white, size = size.small)
        curEntryLabel := label.new(bar_index, close,  "Entry", style = label.style_label_left, color = entryLineColor, textcolor = color.white, size = size.small)
        curSLLabel    := label.new(bar_index, longSL, "SL",    style = label.style_label_left, color = slLineColor,    textcolor = color.white, size = size.small)
    if showSLTPZones
        curProfitBox := box.new(left = bar_index, top = longTP, right = bar_index, bottom = close, bgcolor = profitBoxColor, border_color = color.new(tpLineColor, 60))
        curLossBox   := box.new(left = bar_index, top = close,  right = bar_index, bottom = longSL, bgcolor = lossBoxColor,  border_color = color.new(slLineColor, 60))

if shortSignal and strategy.position_size >= 0 and shortRisk > 0
    shortAlertMsg = use3Commas ? f_build3CommasMsg() :
         '{"strategy":"Lexxie Debug Entries","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period +
         '","action":"sell","price":' + str.tostring(close) + ',"stop":' + str.tostring(shortSL) + ',"target":' + str.tostring(shortTP) +
         ',"pattern":"' + shortSignalText + '","time":"' + str.tostring(time) + '"}'
    shortCloseMsg = use3Commas ? f_build3CommasMsg() :
         '{"strategy":"Lexxie Debug Entries","symbol":"' + syminfo.ticker + '","action":"close_short","price":{{strategy.order.price}},"time":"{{time}}"}'
    strategy.entry("Short", strategy.short, alert_message = shortAlertMsg)
    strategy.exit("Short Exit", "Short", stop = shortSL, limit = shortTP, alert_message = shortCloseMsg)
    if showLabels
        label.new(bar_index, high, "Sell", style = label.style_label_down, color = sellColor, textcolor = color.white, size = labelTextSize)
        label.new(bar_index, high + atrTrade * 0.6, "SE\n" + str.tostring(close, format.mintick), style = label.style_label_down,
             color = infoColor, textcolor = color.gray, size = size.tiny)
    if useWebhookAlerts
        alert(shortAlertMsg, alert.freq_once_per_bar_close)
    if showSLTPLines
        curTPLine     := line.new(bar_index, shortTP, bar_index, shortTP, color = tpLineColor,    style = line.style_dashed, width = 1)
        curEntryLine  := line.new(bar_index, close,    bar_index, close,   color = entryLineColor, style = line.style_dashed, width = 1)
        curSLLine     := line.new(bar_index, shortSL,  bar_index, shortSL, color = slLineColor,    style = line.style_dashed, width = 1)
        curTPLabel    := label.new(bar_index, shortTP, "TP",    style = label.style_label_left, color = tpLineColor,    textcolor = color.white, size = size.small)
        curEntryLabel := label.new(bar_index, close,   "Entry", style = label.style_label_left, color = entryLineColor, textcolor = color.white, size = size.small)
        curSLLabel    := label.new(bar_index, shortSL, "SL",    style = label.style_label_left, color = slLineColor,    textcolor = color.white, size = size.small)
    if showSLTPZones
        curProfitBox := box.new(left = bar_index, top = close,    right = bar_index, bottom = shortTP, bgcolor = profitBoxColor, border_color = color.new(tpLineColor, 60))
        curLossBox   := box.new(left = bar_index, top = shortSL,  right = bar_index, bottom = close,   bgcolor = lossBoxColor,  border_color = color.new(slLineColor, 60))

// Extend the active trade's Entry/TP/SL lines and zone box to follow the current bar until
// the position closes - this naturally stops the instant the trade exits, so it never
// creeps into the next trade's bars. All three lines stay aligned with the box edges since
// they share the exact same price values the box was built from.
if showSLTPLines and strategy.position_size != 0 and not na(curTPLine)
    line.set_x2(curTPLine, bar_index)
    line.set_x2(curEntryLine, bar_index)
    line.set_x2(curSLLine, bar_index)
    label.set_x(curTPLabel, bar_index)
    label.set_x(curEntryLabel, bar_index)
    label.set_x(curSLLabel, bar_index)
if showSLTPZones and strategy.position_size != 0 and not na(curProfitBox)
    box.set_right(curProfitBox, bar_index)
    box.set_right(curLossBox, bar_index)

alertcondition(longSignal,  title = "Lexxie Buy Signal",  message = "Lexxie: Buy signal detected")
alertcondition(shortSignal, title = "Lexxie Sell Signal", message = "Lexxie: Sell signal detected")

// =====================================================================================
// PERFORMANCE TRACKING (win rate, win/loss, daily win/loss, drawdown)
// =====================================================================================

var int    totalWins        = 0
var int    totalLosses      = 0
var int    dailyWins        = 0
var int    dailyLosses      = 0
var int    weekWins         = 0
var int    weekLosses       = 0
var int    monthWins        = 0
var int    monthLosses      = 0
var int    lastClosedTrades = 0
var float  peakEquity       = strategy.initial_capital
var float  maxDrawdownPct   = 0.0
var float  dailyPnL         = 0.0
var float  worstDayPnL      = na
var string worstDayDate     = "-"
var string dayLabel         = ""
var array<float>  last30PnL   = array.new<float>()
var array<string> last30Dates = array.new<string>()
var int lastProcessedDay   = na
var int lastProcessedWeek  = na
var int lastProcessedMonth = na

today      = str.format_time(time, "MM/dd")
lastUpdate = str.format_time(time, "MM/dd HH:mm")

dayTime   = time("D")
weekTime  = time("W")
monthTime = time("M")

// Guards on the actual day/week/month value having changed since it was last
// processed, not just "did it change vs the previous bar" - ta.change() alone
// would stay true for every tick of the whole first bar of a new period (since
// calc_on_every_tick=true and time() is constant within a bar), which would
// re-run these resets on every tick and could wipe out a win/loss that was
// just recorded moments earlier in the same bar.
newDay   = na(lastProcessedDay)   or dayTime   != lastProcessedDay
newWeek  = na(lastProcessedWeek)  or weekTime  != lastProcessedWeek
newMonth = na(lastProcessedMonth) or monthTime != lastProcessedMonth

if newDay
    if na(worstDayPnL) or dailyPnL < worstDayPnL
        worstDayPnL  := dailyPnL
        worstDayDate := dayLabel
    array.push(last30PnL, dailyPnL)
    array.push(last30Dates, dayLabel)
    if array.size(last30PnL) > 30
        array.shift(last30PnL)
        array.shift(last30Dates)
    dailyWins   := 0
    dailyLosses := 0
    dailyPnL    := 0.0
    lastProcessedDay := dayTime

dayLabel := today

if newWeek
    weekWins   := 0
    weekLosses := 0
    lastProcessedWeek := weekTime

if newMonth
    monthWins   := 0
    monthLosses := 0
    lastProcessedMonth := monthTime

if strategy.closedtrades > lastClosedTrades
    for i = lastClosedTrades to strategy.closedtrades - 1
        tradeProfit = strategy.closedtrades.profit(i)
        dailyPnL += tradeProfit
        if tradeProfit > 0
            totalWins  += 1
            dailyWins  += 1
            weekWins   += 1
            monthWins  += 1
        else if tradeProfit < 0
            totalLosses   += 1
            dailyLosses    += 1
            weekLosses     += 1
            monthLosses    += 1
    lastClosedTrades := strategy.closedtrades

equityNow = strategy.equity
if equityNow > peakEquity
    peakEquity := equityNow
drawdownNow = peakEquity > 0 ? (peakEquity - equityNow) / peakEquity * 100 : 0.0
if drawdownNow > maxDrawdownPct
    maxDrawdownPct := drawdownNow

totalTrades = totalWins + totalLosses
winRate = totalTrades > 0 ? totalWins / totalTrades * 100 : 0.0

worst30PnL  = array.size(last30PnL) > 0 ? array.min(last30PnL) : na
worst30Date = array.size(last30PnL) > 0 ? array.get(last30Dates, array.indexof(last30PnL, worst30PnL)) : "-"

// =====================================================================================
// STATS TABLE - top right corner (position configurable)
// =====================================================================================

var table statsTable = table.new(tablePos, 2, 16, border_width = 1, border_color = color.new(color.gray, 0), frame_color = color.new(color.gray, 0), frame_width = 1)

if showTable and barstate.islast
    table.cell(statsTable, 0, 0, "Lexxie Debug Stats", text_color = color.white, bgcolor = color.new(color.navy, 0), text_size = tableTextSize)
    table.merge_cells(statsTable, 0, 0, 1, 0)

    table.cell(statsTable, 0, 1, "Win %",        text_size = tableTextSize, bgcolor = color.new(color.gray, 70))
    table.cell(statsTable, 1, 1, str.tostring(winRate, "#.##") + "%", text_size = tableTextSize, bgcolor = color.new(color.gray, 70))

    table.cell(statsTable, 0, 2, "Win",          text_size = tableTextSize)
    table.cell(statsTable, 1, 2, str.tostring(totalWins), text_size = tableTextSize, text_color = color.green)

    table.cell(statsTable, 0, 3, "Loss",         text_size = tableTextSize, bgcolor = color.new(color.gray, 70))
    table.cell(statsTable, 1, 3, str.tostring(totalLosses), text_size = tableTextSize, text_color = color.red, bgcolor = color.new(color.gray, 70))

    table.cell(statsTable, 0, 4, "Day Win",      text_size = tableTextSize)
    table.cell(statsTable, 1, 4, str.tostring(dailyWins), text_size = tableTextSize, text_color = color.green)

    table.cell(statsTable, 0, 5, "Day Loss",     text_size = tableTextSize, bgcolor = color.new(color.gray, 70))
    table.cell(statsTable, 1, 5, str.tostring(dailyLosses), text_size = tableTextSize, text_color = color.red, bgcolor = color.new(color.gray, 70))

    table.cell(statsTable, 0, 6, "DD",           text_size = tableTextSize)
    table.cell(statsTable, 1, 6, str.tostring(maxDrawdownPct, "#.##") + "%", text_size = tableTextSize, text_color = color.orange)

    table.cell(statsTable, 0, 7, "R:R",          text_size = tableTextSize, bgcolor = color.new(color.gray, 70))
    table.cell(statsTable, 1, 7, "1:" + str.tostring(rrRatio, "#.##"), text_size = tableTextSize, bgcolor = color.new(color.gray, 70))

    worstDayText = na(worstDayPnL) ? "N/A" : "$" + str.tostring(worstDayPnL, "#.##") + " (" + worstDayDate + ")"
    table.cell(statsTable, 0, 8, "Wst Day",      text_size = tableTextSize)
    table.cell(statsTable, 1, 8, worstDayText,   text_size = tableTextSize, text_color = color.red)

    worst30Text = na(worst30PnL) ? "N/A" : "$" + str.tostring(worst30PnL, "#.##") + " (" + worst30Date + ")"
    table.cell(statsTable, 0, 9, "30D Worst",    text_size = tableTextSize, bgcolor = color.new(color.gray, 70))
    table.cell(statsTable, 1, 9, worst30Text,    text_size = tableTextSize, text_color = color.red, bgcolor = color.new(color.gray, 70))

    table.cell(statsTable, 0, 10, "Wk Win",      text_size = tableTextSize)
    table.cell(statsTable, 1, 10, str.tostring(weekWins), text_size = tableTextSize, text_color = color.green)

    table.cell(statsTable, 0, 11, "Wk Loss",     text_size = tableTextSize, bgcolor = color.new(color.gray, 70))
    table.cell(statsTable, 1, 11, str.tostring(weekLosses), text_size = tableTextSize, text_color = color.red, bgcolor = color.new(color.gray, 70))

    table.cell(statsTable, 0, 12, "MT Win",      text_size = tableTextSize)
    table.cell(statsTable, 1, 12, str.tostring(monthWins), text_size = tableTextSize, text_color = color.green)

    table.cell(statsTable, 0, 13, "MT Loss",     text_size = tableTextSize, bgcolor = color.new(color.gray, 70))
    table.cell(statsTable, 1, 13, str.tostring(monthLosses), text_size = tableTextSize, text_color = color.red, bgcolor = color.new(color.gray, 70))

    table.cell(statsTable, 0, 14, "Updated",     text_size = tableTextSize)
    table.cell(statsTable, 1, 14, lastUpdate,    text_size = tableTextSize)

    rsiLevelText  = rsiValue >= rsiOverbought ? "OB" : rsiValue <= rsiOversold ? "OS" : "Neutral"
    rsiLevelColor = rsiValue >= rsiOverbought ? color.red : rsiValue <= rsiOversold ? color.green : color.gray
    table.cell(statsTable, 0, 15, "RSI (" + str.tostring(rsiLen) + ")", text_size = tableTextSize, bgcolor = color.new(color.gray, 70))
    table.cell(statsTable, 1, 15, str.tostring(rsiValue, "#.##") + " " + rsiLevelText, text_size = tableTextSize, text_color = rsiLevelColor, bgcolor = color.new(color.gray, 70))
