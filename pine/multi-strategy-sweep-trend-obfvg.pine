//@version=6
strategy("Multi-Strategy: Sweep Reversal & Trend Continuation (OB/FVG)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=4, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0, calc_on_every_tick=false, process_orders_on_close=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ============================================================================
// HOW TO USE
// This script pulls both the sweep/trend timeframe AND the entry timeframe
// via request.security(), and evaluates mitigation/rejection against the
// ENTRY TIMEFRAME's own closed candle — not the chart's bars. This means
// signal DETECTION works correctly regardless of what timeframe you have
// the chart open on (a 1H chart with a 5M entry pair will still detect
// every valid 5M mitigation event).
//
// However, actual ORDER EXECUTION (strategy.entry/strategy.exit fills) can
// only happen at the chart's own bar granularity — Pine's strategy engine
// has no concept of "fill mid-way through a chart bar." So for the most
// accurate backtest fills/equity curve, still open the chart on (or below)
// your fastest enabled entry timeframe. Running on a coarser chart will now
// correctly find and log the same trades, just with fill timing snapped to
// the coarser chart's bar closes instead of the exact entry-TF candle.
//
// BACKTESTING: each of the 4 pair/strategy combinations places real orders
// via strategy.entry()/strategy.exit() under its own unique ID, so they all
// show up as separate trades in TradingView's Strategy Tester "List of
// Trades" tab, and the Overview/Performance tabs reflect a real backtest
// (equity curve, drawdown, commission if you set it, etc.). Position size,
// commission, and slippage defaults above can be changed either here in code
// or in the strategy's Properties tab on the chart.
//
// process_orders_on_close=true makes strategy.entry()/strategy.exit() fill
// at the CLOSE of the signal bar (matching this script's own internal
// entryPx/slPx/tpPx math, which is anchored to that same close) instead of
// TradingView's default of filling at the OPEN of the next bar. Without
// this, the real backtest fills and this script's own SL/TP levels would
// drift apart on gappy symbols/timeframes.
// ============================================================================

// ---------------------------------------------------------------------------
// GROUPS
// ---------------------------------------------------------------------------
gStrat   = "Strategies"
g1       = "Strategy 1: Sweep Reversal"
g2       = "Strategy 2: Trend Continuation"
gRisk    = "Risk / Trade Management"
gSession = "Session Filter"
gTable   = "Performance Table"
gWebhook = "Webhook Alerts"
gVisual  = "Visuals"

// ---------------------------------------------------------------------------
// MASTER STRATEGY TOGGLES
// ---------------------------------------------------------------------------
enableS1 = input.bool(true,  "Enable Strategy 1: Sweep Reversal",     group = gStrat)
enableS2 = input.bool(false, "Enable Strategy 2: Trend Continuation", group = gStrat)

// ---------------------------------------------------------------------------
// STRATEGY 1 INPUTS
// ---------------------------------------------------------------------------
s1_4h_on = input.bool(true,  "4H Sweep Detection: ON/OFF",       group = g1)
s1_4h_tf = input.timeframe("240", "4H Sweep Detection Timeframe", group = g1)
s1_5m_on = input.bool(true,  "5M Entry Confirmation: ON/OFF",    group = g1)
s1_5m_tf = input.timeframe("5",   "5M Entry Confirmation Timeframe", group = g1)

s1_1h_on = input.bool(false, "1H Sweep Detection: ON/OFF",       group = g1)
s1_1h_tf = input.timeframe("60",  "1H Sweep Detection Timeframe", group = g1)
s1_1m_on = input.bool(false, "1M Entry Confirmation: ON/OFF",    group = g1)
s1_1m_tf = input.timeframe("1",   "1M Entry Confirmation Timeframe", group = g1)

s1_requireFullClose  = input.bool(true, "S1: Require Full-Body Close Through Swept Level", group = g1)
s1_useOB              = input.bool(true, "S1: Use Order Block Detection", group = g1)
s1_useFVG             = input.bool(true, "S1: Use Fair Value Gap Detection", group = g1)
s1_maxWaitBars        = input.int(200, "S1: Max Entry-TF Bars to Wait After Arming", minval = 1, group = g1)
s1_oneSignalPerSweep  = input.bool(true, "S1: One Signal Per Sweep", group = g1)

// ---------------------------------------------------------------------------
// STRATEGY 2 INPUTS
// ---------------------------------------------------------------------------
s2_1h_on = input.bool(true,  "1H Trend Candle Detection: ON/OFF",  group = g2)
s2_1h_tf = input.timeframe("60",  "1H Trend Candle Detection Timeframe", group = g2)
s2_1m_on = input.bool(true,  "1M FVG Entry Confirmation: ON/OFF", group = g2)
s2_1m_tf = input.timeframe("1",   "1M FVG Entry Confirmation Timeframe", group = g2)

s2_4h_on = input.bool(false, "4H Trend Candle Detection: ON/OFF",  group = g2)
s2_4h_tf = input.timeframe("240", "4H Trend Candle Detection Timeframe", group = g2)
s2_5m_on = input.bool(false, "5M FVG Entry Confirmation: ON/OFF", group = g2)
s2_5m_tf = input.timeframe("5",   "5M FVG Entry Confirmation Timeframe", group = g2)

s2_trendMethod = input.string("Auto (EMA)", "S2: Trend Detection Method", options = ["Auto (EMA)", "Auto (Structure)", "Manual"], group = g2)
s2_emaLen      = input.int(50, "S2: EMA Length (Auto EMA method)", group = g2)
s2_swingN      = input.int(3,  "S2: Swing Lookback N (Auto Structure method)", group = g2)
s2_manualBias  = input.string("Bullish", "S2: Manual Trend Bias (Manual method)", options = ["Bullish", "Bearish", "Both"], group = g2)

s2_requireFullClose = input.bool(true, "S2: Require Full-Body Close Beyond Previous Candle", group = g2)
s2_maxWaitBars       = input.int(200, "S2: Max Entry-TF Bars to Wait After Arming", minval = 1, group = g2)
s2_oneSignalPerCont  = input.bool(true, "S2: One Signal Per Continuation", group = g2)

// ---------------------------------------------------------------------------
// RISK / TRADE MANAGEMENT (shared)
// ---------------------------------------------------------------------------
rrMultiple      = input.float(2.0, "Risk:Reward Multiple (default 1:2)", minval = 0.1, group = gRisk)
enableBE        = input.bool(false, "Enable Break-Even", group = gRisk)
beTriggerR      = input.float(1.0, "Break-Even Trigger (R)", minval = 0.1, group = gRisk)
maxTradesPerDay = input.int(0, "Max Trades Per Day (0 = unlimited)", minval = 0, group = gRisk)

// ---------------------------------------------------------------------------
// SESSION FILTER (shared, optional)
// ---------------------------------------------------------------------------
enableSession = input.bool(false, "Enable Session Filter", group = gSession)
sessionPreset = input.string("London", "Session Preset", options = ["London", "New York", "Asian", "London-NY Overlap", "Custom"], group = gSession)
customSession = input.session("0800-1700", "Custom Session (used when preset = Custom)", group = gSession)
sessionTZ     = input.string("Etc/UTC", "Session Timezone", group = gSession)

// ---------------------------------------------------------------------------
// PERFORMANCE TABLE (shared)
// ---------------------------------------------------------------------------
showTable     = input.bool(true, "Show Performance Table", group = gTable)
tableBgColor  = input.color(color.new(color.red, 0), "Table Background Color", group = gTable)
tableTxtColor = input.color(color.white, "Table Text Color", group = gTable)

// ---------------------------------------------------------------------------
// WEBHOOK ALERTS (shared)
// ---------------------------------------------------------------------------
enableWebhook   = input.bool(true, "Enable Webhook Alerts", group = gWebhook)
webhookTemplate = input.text_area("{\"strategy\":\"{{strategy}}\",\"pair\":\"{{pair}}\",\"action\":\"{{action}}\",\"symbol\":\"{{ticker}}\",\"price\":{{price}},\"stop_loss\":{{sl}},\"take_profit\":{{tp}},\"risk_reward\":{{rr}},\"time\":\"{{time}}\"}", "Webhook JSON Template", group = gWebhook)
fireIntrabar    = input.bool(false, "Fire Alerts Intra-bar (else on bar close)", group = gWebhook)

// ---------------------------------------------------------------------------
// VISUAL COLORS (shared)
// ---------------------------------------------------------------------------
bullColor = input.color(color.new(color.lime, 0), "Bullish Zone / Label Color", group = gVisual)
bearColor = input.color(color.new(color.red, 0),  "Bearish Zone / Label Color", group = gVisual)

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// CURRENT (possibly still-forming) candle on a given timeframe — the most
// basic, standard request.security() usage with no [1] offset inside the
// expression. Each calling function tracks the PREVIOUS fetch itself (in
// var state) to detect when this timeframe's bar has rolled over, and to
// recover the final OHLC of the candle that just closed. This avoids a
// known Pine gotcha where combining historical-offset operators like [1]
// directly inside a request.security() expression can behave unreliably;
// keeping request.security() to plain "current value" calls and doing all
// "what was the previous bar" bookkeeping in ordinary script state is the
// standard, well-tested approach.
f_htfNow(tf) =>
    [o, h, l, c, t] = request.security(syminfo.tickerid, tf, [open, high, low, close, time], lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
    [o, h, l, c, t]

f_sessionString(preset, custom) =>
    string s = switch preset
        "London"            => "0700-1600"
        "New York"          => "1300-2200"
        "Asian"             => "0000-0900"
        "London-NY Overlap" => "1300-1600"
        => custom
    s

sessString = f_sessionString(sessionPreset, customSession)

f_inSession(tf) =>
    not enableSession or not na(time(tf, sessString, sessionTZ))

// Trend direction for Strategy 2, evaluated on the trend-detection timeframe.
// Uses the CURRENT (live) HTF close/EMA — acceptable here since this is a
// continuous directional filter, not a discrete candle pattern, so it's fine
// for it to track the live-forming HTF candle rather than needing a frozen
// closed-candle boundary the way sweep/continuation detection does.
// dirOut: 1 = bullish trend, -1 = bearish trend, 2 = "Both" (Manual mode
// only) — removes the directional filter entirely so continuation candles
// are accepted in either direction, purely on their own color/close.
f_trendDir(tf, method, emaLen, swingN, manualBias) =>
    float closeVal = request.security(syminfo.tickerid, tf, close, lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
    int dirOut = 0
    if method == "Manual"
        dirOut := manualBias == "Bullish" ? 1 : manualBias == "Bearish" ? -1 : 2
    else if method == "Auto (EMA)"
        float emaVal = request.security(syminfo.tickerid, tf, ta.ema(close, emaLen), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
        dirOut := closeVal > emaVal ? 1 : closeVal < emaVal ? -1 : 0
    else
        float pastClose = request.security(syminfo.tickerid, tf, close[swingN], lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
        dirOut := closeVal > pastClose ? 1 : closeVal < pastClose ? -1 : 0
    dirOut

// Webhook JSON builder — substitutes our custom placeholders; TradingView's
// own {{ticker}} / {{time}} placeholders (if left in the template) are filled
// in by TradingView itself when the alert fires.
f_webhookMsg(template, stratTag, pairTag, action, price, sl, tp, rr) =>
    string msg = template
    msg := str.replace_all(msg, "{{strategy}}", stratTag)
    msg := str.replace_all(msg, "{{pair}}", pairTag)
    msg := str.replace_all(msg, "{{action}}", action)
    msg := str.replace_all(msg, "{{price}}", str.tostring(price))
    msg := str.replace_all(msg, "{{sl}}", str.tostring(sl))
    msg := str.replace_all(msg, "{{tp}}", str.tostring(tp))
    msg := str.replace_all(msg, "{{rr}}", str.tostring(rr))
    msg

// ============================================================================
// STRATEGY 1 ENGINE — SWEEP REVERSAL (called once per pair)
// Returns: [result, justEntered, tradeDir, entryPx, slPx, tpPx, sweepJustDetected, zoneJustFound]
//   result: 0 = nothing resolved this bar, 1 = win, -1 = loss, 2 = break-even exit
//   sweepJustDetected/zoneJustFound: diagnostic pulses for this bar only, used
//   to feed the "Sweeps Detected / Zones Found" counters in the performance
//   table, so it's visible which stage of the funnel (if any) is producing
//   nothing when a symbol/timeframe combo yields zero trades.
// ============================================================================
f_sweepPair(pairTag, pairId, sweepOn, sweepTF, entryOn, entryTF, requireFullClose, useOB, useFVG, maxWaitBars, oneSignalPerSweep, rr, canTradeMore, bullCol, bearCol) =>
    var float c1o = na
    var float c1h = na
    var float c1l = na
    var float c1c = na
    var float c2o = na
    var float c2h = na
    var float c2l = na
    var float c2c = na

    var bool armed        = false
    var bool waitingEntry = false
    var int  dirState     = 0
    var int  barsWaited   = 0

    var float e1o = na
    var float e1h = na
    var float e1l = na
    var float e2o = na
    var float e2h = na
    var float e2l = na
    var float e2c = na
    var float e3o = na
    var float e3h = na
    var float e3l = na
    var float e3c = na

    var float obfvgTop = na
    var float obfvgBot = na

    var bool  inTrade  = false
    var int   tradeDir = 0
    var float entryPx  = na
    var float slPx     = na
    var float tpPx     = na
    var bool  beDone    = false

    // Live-candle trackers. Each bar we fetch the CURRENT (possibly still
    // forming) sweep-TF / entry-TF candle via f_htfNow (no [1] inside the
    // security() expression — that combination is a known Pine gotcha that
    // can silently return stale/frozen data). When the fetched timestamp
    // differs from what we stored LAST bar, the timeframe just rolled over,
    // which means the values we stored LAST bar are the final, closed OHLC
    // of the candle that just finished. This is the standard non-repainting
    // "detect HTF close" pattern.
    var float curSO = na
    var float curSH = na
    var float curSL = na
    var float curSC = na
    var int   curST = na
    var float curEO = na
    var float curEH = na
    var float curEL = na
    var float curEC = na
    var int   curET = na

    int  result      = 0
    bool justEntered = false
    bool sweepJustDetected = false
    bool zoneJustFound     = false
    bool htfBarSeen        = false

    pairEnabled = sweepOn and entryOn

    if pairEnabled
        [so, sh, sl_, sc, st] = f_htfNow(sweepTF)
        [eo, eh, el, ec, et]  = f_htfNow(entryTF)

        newSweepBar = not na(curST) and st != curST
        newEntryBar = not na(curET) and et != curET

        // Snapshot of what curS*/curE* held BEFORE this bar's update below —
        // i.e. the final OHLC of the sweep-TF / entry-TF candle that just closed.
        float closedSO = curSO
        float closedSH = curSH
        float closedSL = curSL
        float closedSC = curSC
        float closedEO = curEO
        float closedEH = curEH
        float closedEL = curEL
        float closedEC = curEC

        // STEP 1 — shift and detect the sweep pair (C1 = reference, C2 = sweep).
        // Only shift/redetect while NOT already armed — otherwise a setup
        // that's armed and waiting on the entry TF would have its c1/c2 (and
        // therefore its stop-loss reference) silently overwritten by every
        // subsequent sweep-TF close, corrupting the stop level. While armed,
        // we instead just check invalidation against the newly-closed candle.
        if newSweepBar
            htfBarSeen := true

            if not armed
                c1o := c2o
                c1h := c2h
                c1l := c2l
                c1c := c2c
                c2o := closedSO
                c2h := closedSH
                c2l := closedSL
                c2c := closedSC

                if not na(c1c)
                    bool c1Bull    = c1c > c1o
                    bool c2Bull    = c2c > c2o
                    bool oppColors = c1Bull != c2Bull
                    bool bearSweep = c2l < c1l and (requireFullClose ? c2c < c1l : true)
                    bool bullSweep = c2h > c1h and (requireFullClose ? c2c > c1h : true)

                    if oppColors and bearSweep and not bullSweep
                        dirState     := 1
                        armed        := true
                        waitingEntry := true
                        barsWaited   := 0
                        sweepJustDetected := true
                        box.new(bar_index[1], math.max(c1h, c2h), bar_index, math.min(c1l, c2l), border_color = bullCol, bgcolor = color.new(bullCol, 85), text = "Sweep [" + pairTag + "]", text_color = bullCol, text_size = size.small)
                        label.new(bar_index, low, "Armed - watching entry TF", style = label.style_label_up, color = bullCol, textcolor = color.white, size = size.tiny)
                    else if oppColors and bullSweep and not bearSweep
                        dirState     := -1
                        armed        := true
                        waitingEntry := true
                        barsWaited   := 0
                        sweepJustDetected := true
                        box.new(bar_index[1], math.max(c1h, c2h), bar_index, math.min(c1l, c2l), border_color = bearCol, bgcolor = color.new(bearCol, 85), text = "Sweep [" + pairTag + "]", text_color = bearCol, text_size = size.small)
                        label.new(bar_index, high, "Armed - watching entry TF", style = label.style_label_down, color = bearCol, textcolor = color.white, size = size.tiny)

            else if waitingEntry
                if dirState == 1 and closedSC < c2l
                    armed        := false
                    waitingEntry := false
                if dirState == -1 and closedSC > c2h
                    armed        := false
                    waitingEntry := false

        if waitingEntry and newEntryBar
            barsWaited += 1
            if barsWaited > maxWaitBars
                armed        := false
                waitingEntry := false

        // STEP 3 — OB/FVG zone detection on the entry timeframe
        // Rolling entry-TF candle history is maintained on EVERY new entry-TF
        // close, regardless of armed state, so the buffer is already
        // up to date the moment a setup arms (rather than stale from
        // whenever it last updated during a previous armed window).
        if newEntryBar
            e1o := e2o
            e1h := e2h
            e1l := e2l
            e2o := e3o
            e2h := e3h
            e2l := e3l
            e2c := e3c
            e3o := closedEO
            e3h := closedEH
            e3l := closedEL
            e3c := closedEC

        bool zoneJustSet = false
        if newEntryBar and armed and waitingEntry and not inTrade
            bool  gotZone = false
            float zTop = na
            float zBot = na

            if dirState == 1
                if useFVG and not na(e1h) and e3l > e1h
                    zTop := e3l
                    zBot := e1h
                    gotZone := true
                else if useOB and not na(e2o) and e2c < e2o and e3c > e3o and e3c > e2h
                    zTop := e2h
                    zBot := e2l
                    gotZone := true
            else if dirState == -1
                if useFVG and not na(e1l) and e3h < e1l
                    zTop := e1l
                    zBot := e3h
                    gotZone := true
                else if useOB and not na(e2o) and e2c > e2o and e3c < e3o and e3c < e2l
                    zTop := e2h
                    zBot := e2l
                    gotZone := true

            if gotZone
                obfvgTop  := zTop
                obfvgBot  := zBot
                zoneJustSet    := true
                zoneJustFound  := true
                box.new(bar_index - 2, zTop, bar_index + 20, zBot, border_color = dirState == 1 ? bullCol : bearCol, bgcolor = color.new(dirState == 1 ? bullCol : bearCol, 80), text = (useFVG ? "FVG" : "OB") + " [" + pairTag + "]", text_color = dirState == 1 ? bullCol : bearCol, text_size = size.small)

        // ENTRY TRIGGER — mitigation + rejection, evaluated on the ENTRY
        // TIMEFRAME's own closed candle (e3), NOT the chart's live bars.
        // This is what makes the script correct no matter what chart
        // timeframe you display it on: checking against live chart bars
        // (the old approach) silently broke down whenever the chart's
        // timeframe was coarser than the entry timeframe (e.g. a 1H chart
        // with a 5M entry pair) — request.security() pulling a LOWER
        // timeframe than the chart is unreliable, so mitigation would
        // rarely or never register, producing zero trades even though a
        // valid setup existed on the actual 5M/1M data. Since e3 is only
        // ever assigned from a snapshot taken the instant the entry-TF's
        // live candle rolled over (see f_htfNow / closedE* above), this
        // check is inherently non-repainting without needing a
        // barstate.isconfirmed gate. zoneJustSet prevents mitigating a
        // zone using the very candle that just formed it.
        if newEntryBar and not zoneJustSet and armed and waitingEntry and not inTrade and not na(obfvgTop) and canTradeMore and f_inSession(entryTF)
            if dirState == 1 and e3l <= obfvgTop and e3c > obfvgBot and e3c > e3o
                inTrade      := true
                tradeDir     := 1
                entryPx      := e3c
                slPx         := math.min(obfvgBot, c2l)
                float riskPts = entryPx - slPx
                tpPx         := entryPx + riskPts * rr
                beDone       := false
                waitingEntry := false
                justEntered  := true
                strategy.entry(pairId, strategy.long)
                strategy.exit(pairId + "X", from_entry = pairId, stop = slPx, limit = tpPx)
                label.new(bar_index, low, "BUY", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
            else if dirState == -1 and e3h >= obfvgBot and e3c < obfvgTop and e3c < e3o
                inTrade      := true
                tradeDir     := -1
                entryPx      := e3c
                slPx         := math.max(obfvgTop, c2h)
                float riskPts = slPx - entryPx
                tpPx         := entryPx - riskPts * rr
                beDone       := false
                waitingEntry := false
                justEntered  := true
                strategy.entry(pairId, strategy.short)
                strategy.exit(pairId + "X", from_entry = pairId, stop = slPx, limit = tpPx)
                label.new(bar_index, high, "SELL", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

        // MANAGE OPEN TRADE — break-even, target, stop. This mirrors what the
        // real strategy.exit() order (placed at entry, above) will do, so our
        // internal win/loss/BE bookkeeping stays in sync with the actual
        // backtest — when break-even moves the stop, we re-issue
        // strategy.exit() with the new stop level to move the real pending
        // order too (re-calling strategy.exit for the same id updates it).
        if inTrade
            if tradeDir == 1
                if enableBE and not beDone and high >= entryPx + (entryPx - slPx) * beTriggerR
                    slPx   := entryPx
                    beDone := true
                    strategy.exit(pairId + "X", from_entry = pairId, stop = slPx, limit = tpPx)
                if high >= tpPx
                    result  := 1
                    inTrade := false
                else if low <= slPx
                    result  := beDone ? 2 : -1
                    inTrade := false
            else
                if enableBE and not beDone and low <= entryPx - (slPx - entryPx) * beTriggerR
                    slPx   := entryPx
                    beDone := true
                    strategy.exit(pairId + "X", from_entry = pairId, stop = slPx, limit = tpPx)
                if low <= tpPx
                    result  := 1
                    inTrade := false
                else if high >= slPx
                    result  := beDone ? 2 : -1
                    inTrade := false

            if not inTrade and oneSignalPerSweep
                armed    := false
                obfvgTop := na
                obfvgBot := na

        // Update live-candle trackers to this bar's fetch, unconditionally,
        // so next bar can detect the rollover the same way.
        curSO := so
        curSH := sh
        curSL := sl_
        curSC := sc
        curST := st
        curEO := eo
        curEH := eh
        curEL := el
        curEC := ec
        curET := et

    [result, justEntered, dirState, entryPx, slPx, tpPx, sweepJustDetected, zoneJustFound, htfBarSeen]

// ============================================================================
// STRATEGY 2 ENGINE — TREND CONTINUATION + FVG ENTRY (called once per pair)
// Returns: [result, justEntered, tradeDir, entryPx, slPx, tpPx, contJustDetected, zoneJustFound]
// ============================================================================
f_contPair(pairTag, pairId, trendOn, trendTF, entryOn, entryTF, trendMethod, emaLen, swingN, manualBias, requireFullClose, maxWaitBars, oneSignalPerCont, rr, canTradeMore, bullCol, bearCol) =>
    var float p_o = na
    var float p_h = na
    var float p_l = na
    var float p_c = na
    var float x_o = na
    var float x_h = na
    var float x_l = na
    var float x_c = na

    var bool armed        = false
    var bool waitingEntry = false
    var int  dirState     = 0
    var int  barsWaited   = 0

    var float e1h = na
    var float e1l = na
    var float e2o = na
    var float e2h = na
    var float e2l = na
    var float e3o = na
    var float e3h = na
    var float e3l = na
    var float e3c = na

    var float fvgTop = na
    var float fvgBot = na

    var bool  inTrade  = false
    var int   tradeDir = 0
    var float entryPx  = na
    var float slPx     = na
    var float tpPx     = na
    var bool  beDone    = false

    // Live-candle trackers — see the matching comment in f_sweepPair for why
    // this replaces the old [1]-inside-security() technique.
    var float curTO = na
    var float curTH = na
    var float curTL = na
    var float curTC = na
    var int   curTT = na
    var float curEO = na
    var float curEH = na
    var float curEL = na
    var float curEC = na
    var int   curET = na

    int  result      = 0
    bool justEntered = false
    bool contJustDetected = false
    bool zoneJustFound    = false
    bool htfBarSeen       = false

    pairEnabled = trendOn and entryOn

    if pairEnabled
        [to_, th, tl, tc, tt] = f_htfNow(trendTF)
        [eo, eh, el, ec, et]  = f_htfNow(entryTF)

        newTrendBar = not na(curTT) and tt != curTT
        newEntryBar = not na(curET) and et != curET

        // Snapshot of what curT*/curE* held BEFORE this bar's update below —
        // i.e. the final OHLC of the trend-TF / entry-TF candle that just closed.
        float closedTO = curTO
        float closedTH = curTH
        float closedTL = curTL
        float closedTC = curTC
        float closedEO = curEO
        float closedEH = curEH
        float closedEL = curEL
        float closedEC = curEC

        trendDirNow = f_trendDir(trendTF, trendMethod, emaLen, swingN, manualBias)

        // Only shift/redetect while NOT already armed — see f_sweepPair for
        // why re-shifting p_/x_ while armed would corrupt the stop reference.
        if newTrendBar
            htfBarSeen := true

            if not armed
                p_o := x_o
                p_h := x_h
                p_l := x_l
                p_c := x_c
                x_o := closedTO
                x_h := closedTH
                x_l := closedTL
                x_c := closedTC

                if not na(p_c)
                    bool xBull    = x_c > x_o
                    // trendDirNow == 2 means "Both" (Manual mode, no directional
                    // filter) — accept continuation candles either way.
                    bool contBull = (trendDirNow == 1 or trendDirNow == 2) and xBull and (requireFullClose ? x_c > p_h : x_h > p_h)
                    bool contBear = (trendDirNow == -1 or trendDirNow == 2) and not xBull and (requireFullClose ? x_c < p_l : x_l < p_l)

                    if contBull
                        dirState     := 1
                        armed        := true
                        waitingEntry := true
                        barsWaited   := 0
                        contJustDetected := true
                        box.new(bar_index[1], math.max(p_h, x_h), bar_index, math.min(p_l, x_l), border_color = bullCol, bgcolor = color.new(bullCol, 85), text = "Continuation [" + pairTag + "]", text_color = bullCol, text_size = size.small)
                        label.new(bar_index, low, "Armed - watching entry TF", style = label.style_label_up, color = bullCol, textcolor = color.white, size = size.tiny)
                    else if contBear
                        dirState     := -1
                        armed        := true
                        waitingEntry := true
                        barsWaited   := 0
                        contJustDetected := true
                        box.new(bar_index[1], math.max(p_h, x_h), bar_index, math.min(p_l, x_l), border_color = bearCol, bgcolor = color.new(bearCol, 85), text = "Continuation [" + pairTag + "]", text_color = bearCol, text_size = size.small)
                        label.new(bar_index, high, "Armed - watching entry TF", style = label.style_label_down, color = bearCol, textcolor = color.white, size = size.tiny)

            else if waitingEntry
                if dirState == 1 and closedTC < x_o
                    armed        := false
                    waitingEntry := false
                if dirState == -1 and closedTC > x_o
                    armed        := false
                    waitingEntry := false

        if waitingEntry and newEntryBar
            barsWaited += 1
            if barsWaited > maxWaitBars
                armed        := false
                waitingEntry := false

        // Rolling entry-TF candle history — updated on every new entry-TF
        // close regardless of armed state (see note in f_sweepPair).
        if newEntryBar
            e1h := e2h
            e1l := e2l
            e2o := e3o
            e2h := e3h
            e2l := e3l
            e3o := closedEO
            e3h := closedEH
            e3l := closedEL
            e3c := closedEC

        // ENTRY-TF FVG detection (trend-direction pullback zone only, no OB for S2)
        bool zoneJustSet = false
        if newEntryBar and armed and waitingEntry and not inTrade
            bool  gotZone = false
            float zTop = na
            float zBot = na
            if dirState == 1 and not na(e1h) and e3l > e1h
                zTop := e3l
                zBot := e1h
                gotZone := true
            else if dirState == -1 and not na(e1l) and e3h < e1l
                zTop := e1l
                zBot := e3h
                gotZone := true

            if gotZone
                fvgTop        := zTop
                fvgBot        := zBot
                zoneJustSet   := true
                zoneJustFound := true
                box.new(bar_index - 2, zTop, bar_index + 20, zBot, border_color = dirState == 1 ? bullCol : bearCol, bgcolor = color.new(dirState == 1 ? bullCol : bearCol, 80), text = "FVG [" + pairTag + "]", text_color = dirState == 1 ? bullCol : bearCol, text_size = size.small)

        // ENTRY TRIGGER — pullback into FVG, rejection back WITH the trend,
        // evaluated on the ENTRY TIMEFRAME's own closed candle (e3), not the
        // chart's live bars — see the detailed comment in f_sweepPair for
        // why this matters (chart timeframe coarser than entry timeframe
        // silently produced zero trades under the old live-bar approach).
        if newEntryBar and not zoneJustSet and armed and waitingEntry and not inTrade and not na(fvgTop) and canTradeMore and f_inSession(entryTF)
            if dirState == 1 and e3l <= fvgTop and e3c > fvgBot and e3c > e3o
                inTrade      := true
                tradeDir     := 1
                entryPx      := e3c
                slPx         := math.min(fvgBot, x_o)
                float riskPts = entryPx - slPx
                tpPx         := entryPx + riskPts * rr
                beDone       := false
                waitingEntry := false
                justEntered  := true
                strategy.entry(pairId, strategy.long)
                strategy.exit(pairId + "X", from_entry = pairId, stop = slPx, limit = tpPx)
                label.new(bar_index, low, "BUY", style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
            else if dirState == -1 and e3h >= fvgBot and e3c < fvgTop and e3c < e3o
                inTrade      := true
                tradeDir     := -1
                entryPx      := e3c
                slPx         := math.max(fvgTop, x_o)
                float riskPts = slPx - entryPx
                tpPx         := entryPx - riskPts * rr
                beDone       := false
                waitingEntry := false
                justEntered  := true
                strategy.entry(pairId, strategy.short)
                strategy.exit(pairId + "X", from_entry = pairId, stop = slPx, limit = tpPx)
                label.new(bar_index, high, "SELL", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

        // Mirrors the real strategy.exit() order placed at entry above; see
        // the equivalent comment in f_sweepPair for why break-even re-issues
        // strategy.exit() with the moved stop.
        if inTrade
            if tradeDir == 1
                if enableBE and not beDone and high >= entryPx + (entryPx - slPx) * beTriggerR
                    slPx   := entryPx
                    beDone := true
                    strategy.exit(pairId + "X", from_entry = pairId, stop = slPx, limit = tpPx)
                if high >= tpPx
                    result  := 1
                    inTrade := false
                else if low <= slPx
                    result  := beDone ? 2 : -1
                    inTrade := false
            else
                if enableBE and not beDone and low <= entryPx - (slPx - entryPx) * beTriggerR
                    slPx   := entryPx
                    beDone := true
                    strategy.exit(pairId + "X", from_entry = pairId, stop = slPx, limit = tpPx)
                if low <= tpPx
                    result  := 1
                    inTrade := false
                else if high >= slPx
                    result  := beDone ? 2 : -1
                    inTrade := false

            if not inTrade and oneSignalPerCont
                armed  := false
                fvgTop := na
                fvgBot := na

        // Update live-candle trackers to this bar's fetch, unconditionally,
        // so next bar can detect the rollover the same way.
        curTO := to_
        curTH := th
        curTL := tl
        curTC := tc
        curTT := tt
        curEO := eo
        curEH := eh
        curEL := el
        curEC := ec
        curET := et

    [result, justEntered, dirState, entryPx, slPx, tpPx, contJustDetected, zoneJustFound, htfBarSeen]

// ============================================================================
// GLOBAL COUNTERS (performance table + max trades/day)
// ============================================================================
var int   dailyWin    = 0
var int   dailyLoss   = 0
var int   tradesToday = 0
var int   wins        = 0
var int   losses      = 0
var int   beCount     = 0
var float equityR     = 0.0
var float peakR       = 0.0
var float maxDD_R     = 0.0
var int   sweepsDetected = 0
var int   zonesFound     = 0
var int   htfBarsProcessed = 0

newDay = ta.change(time("D")) != 0
if newDay
    dailyWin    := 0
    dailyLoss   := 0
    tradesToday := 0

canTradeMore = maxTradesPerDay <= 0 or tradesToday < maxTradesPerDay

// ============================================================================
// RUN STRATEGY 1 — both pairs
// ============================================================================
[s1aRes, s1aEntered, s1aDir, s1aEntryPx, s1aSL, s1aTP, s1aSweep, s1aZone, s1aHtf] = f_sweepPair("S1 4H/5M", "S1_4H_5M", enableS1 and s1_4h_on, s1_4h_tf, enableS1 and s1_5m_on, s1_5m_tf, s1_requireFullClose, s1_useOB, s1_useFVG, s1_maxWaitBars, s1_oneSignalPerSweep, rrMultiple, canTradeMore, bullColor, bearColor)
[s1bRes, s1bEntered, s1bDir, s1bEntryPx, s1bSL, s1bTP, s1bSweep, s1bZone, s1bHtf] = f_sweepPair("S1 1H/1M", "S1_1H_1M", enableS1 and s1_1h_on, s1_1h_tf, enableS1 and s1_1m_on, s1_1m_tf, s1_requireFullClose, s1_useOB, s1_useFVG, s1_maxWaitBars, s1_oneSignalPerSweep, rrMultiple, canTradeMore, bullColor, bearColor)

// ============================================================================
// RUN STRATEGY 2 — both pairs
// ============================================================================
[s2aRes, s2aEntered, s2aDir, s2aEntryPx, s2aSL, s2aTP, s2aSweep, s2aZone, s2aHtf] = f_contPair("S2 1H/1M", "S2_1H_1M", enableS2 and s2_1h_on, s2_1h_tf, enableS2 and s2_1m_on, s2_1m_tf, s2_trendMethod, s2_emaLen, s2_swingN, s2_manualBias, s2_requireFullClose, s2_maxWaitBars, s2_oneSignalPerCont, rrMultiple, canTradeMore, bullColor, bearColor)
[s2bRes, s2bEntered, s2bDir, s2bEntryPx, s2bSL, s2bTP, s2bSweep, s2bZone, s2bHtf] = f_contPair("S2 4H/5M", "S2_4H_5M", enableS2 and s2_4h_on, s2_4h_tf, enableS2 and s2_5m_on, s2_5m_tf, s2_trendMethod, s2_emaLen, s2_swingN, s2_manualBias, s2_requireFullClose, s2_maxWaitBars, s2_oneSignalPerCont, rrMultiple, canTradeMore, bullColor, bearColor)

// ============================================================================
// AGGREGATE RESULTS INTO GLOBAL COUNTERS
// f_resultDeltas is a pure function (no outer-scope mutation) that just
// converts a result code into deltas; the actual += happens at top level,
// which avoids relying on functions mutating global var state.
// ============================================================================
f_resultDeltas(res) =>
    int   winD  = res == 1 ? 1 : 0
    int   lossD = res == -1 ? 1 : 0
    int   beD   = res == 2 ? 1 : 0
    float eqD   = res == 1 ? rrMultiple : res == -1 ? -1.0 : 0.0
    [winD, lossD, beD, eqD]

[w1, l1, b1, eq1] = f_resultDeltas(s1aRes)
[w2, l2, b2, eq2] = f_resultDeltas(s1bRes)
[w3, l3, b3, eq3] = f_resultDeltas(s2aRes)
[w4, l4, b4, eq4] = f_resultDeltas(s2bRes)

winDelta  = w1 + w2 + w3 + w4
lossDelta = l1 + l2 + l3 + l4
beDelta   = b1 + b2 + b3 + b4
eqDelta   = eq1 + eq2 + eq3 + eq4

wins      += winDelta
losses    += lossDelta
beCount   += beDelta
dailyWin  += winDelta
dailyLoss += lossDelta
equityR   += eqDelta
peakR     := math.max(peakR, equityR)
maxDD_R   := math.max(maxDD_R, peakR - equityR)

tradesThisBar = (s1aEntered ? 1 : 0) + (s1bEntered ? 1 : 0) + (s2aEntered ? 1 : 0) + (s2bEntered ? 1 : 0)
tradesToday += tradesThisBar

sweepsDetected   += (s1aSweep ? 1 : 0) + (s1bSweep ? 1 : 0) + (s2aSweep ? 1 : 0) + (s2bSweep ? 1 : 0)
zonesFound       += (s1aZone ? 1 : 0)  + (s1bZone ? 1 : 0)  + (s2aZone ? 1 : 0)  + (s2bZone ? 1 : 0)
htfBarsProcessed += (s1aHtf ? 1 : 0)   + (s1bHtf ? 1 : 0)   + (s2aHtf ? 1 : 0)   + (s2bHtf ? 1 : 0)

// ============================================================================
// WEBHOOK ALERTS
// ============================================================================
f_fireWebhook(entered, stratTag, pairTag, dirVal, entryPxVal, slVal, tpVal) =>
    if enableWebhook and entered
        action = dirVal == 1 ? "buy" : "sell"
        msg = f_webhookMsg(webhookTemplate, stratTag, pairTag, action, entryPxVal, slVal, tpVal, rrMultiple)
        alert(msg, fireIntrabar ? alert.freq_once_per_bar : alert.freq_once_per_bar_close)

f_fireWebhook(s1aEntered, "S1", "4H/5M", s1aDir, s1aEntryPx, s1aSL, s1aTP)
f_fireWebhook(s1bEntered, "S1", "1H/1M", s1bDir, s1bEntryPx, s1bSL, s1bTP)
f_fireWebhook(s2aEntered, "S2", "1H/1M", s2aDir, s2aEntryPx, s2aSL, s2aTP)
f_fireWebhook(s2bEntered, "S2", "4H/5M", s2bDir, s2bEntryPx, s2bSL, s2bTP)

// ============================================================================
// GENERIC ALERTCONDITIONS (for TradingView's Alert dialog)
// ============================================================================
anyEntryLong  = (s1aEntered and s1aDir == 1)  or (s1bEntered and s1bDir == 1)  or (s2aEntered and s2aDir == 1)  or (s2bEntered and s2bDir == 1)
anyEntryShort = (s1aEntered and s1aDir == -1) or (s1bEntered and s1bDir == -1) or (s2aEntered and s2aDir == -1) or (s2bEntered and s2bDir == -1)
alertcondition(anyEntryLong,  title = "Entry Triggered - Long",  message = "Long entry triggered")
alertcondition(anyEntryShort, title = "Entry Triggered - Short", message = "Short entry triggered")

maxTradesHitNow = maxTradesPerDay > 0 and tradesToday >= maxTradesPerDay and tradesThisBar > 0
alertcondition(maxTradesHitNow, title = "Max Trades Per Day Reached", message = "Max trades per day reached")

// ============================================================================
// PERFORMANCE TABLE — top-right corner, red background by default
// Created once (var, outside any signal condition) so it is visible the
// instant the script loads. Redrawn on EVERY bar (not gated to
// barstate.islast) — islast refers to the last bar of the full dataset,
// which never becomes true while paused mid-way through Bar Replay, so
// gating on it left the table blank during replay testing. Writing every
// bar costs a little more but guarantees the table is always populated,
// live, in replay, or on history.
// ============================================================================
var table perfTable = table.new(position.top_right, 2, 10, bgcolor = tableBgColor, border_width = 1)

if showTable
    winRate = (wins + losses) > 0 ? (wins / (wins + losses)) * 100.0 : 0.0
    ddPct   = peakR > 0 ? (maxDD_R / peakR) * 100.0 : 0.0

    table.cell(perfTable, 0, 0, "Performance",       text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 0, "",                  text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 1, "HTF Bars Processed", text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 1, str.tostring(htfBarsProcessed), text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 2, "Sweeps / Continuations", text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 2, str.tostring(sweepsDetected), text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 3, "Zones Found (OB/FVG)", text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 3, str.tostring(zonesFound), text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 4, "Win Rate",          text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 4, str.tostring(winRate, "0.##") + "%", text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 5, "Wins / Losses",     text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 5, str.tostring(wins) + " / " + str.tostring(losses), text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 6, "Daily Win / Loss",  text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 6, str.tostring(dailyWin) + " / " + str.tostring(dailyLoss), text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 7, "Drawdown (R / %)",  text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 7, str.tostring(maxDD_R, "0.##") + "R / " + str.tostring(ddPct, "0.##") + "%", text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 8, "Break-Even Exits",  text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 8, str.tostring(beCount), text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 0, 9, "Trades Today",      text_color = tableTxtColor, bgcolor = tableBgColor)
    table.cell(perfTable, 1, 9, str.tostring(tradesToday) + (maxTradesPerDay > 0 ? " / " + str.tostring(maxTradesPerDay) : ""), text_color = tableTxtColor, bgcolor = tableBgColor)

// ============================================================================
// KNOWN LIMITATIONS / IMPLEMENTATION NOTES
// - Written directly from the prompt spec; not yet run through the TradingView
//   Pine compiler. Paste into the Pine Editor and report any error messages
//   back so they can be fixed line-by-line.
// - "Closed HTF candle" detection fetches the CURRENT/live HTF candle every
//   bar via request.security() (f_htfNow, no [1] inside the expression) and
//   tracks the previous fetch in ordinary var state; when the fetched
//   timestamp changes, the PRIOR stored values are the just-closed candle's
//   final OHLC. This is non-repainting and always one HTF bar behind the
//   live-forming candle — appropriate since every pattern is defined on
//   CLOSED candles.
// - Entry mitigation/rejection is evaluated against the entry timeframe's
//   own closed candle (via request.security), not the chart's bars, so
//   detection works on any chart timeframe. Order FILL timing is still
//   snapped to the chart's own bar granularity (a Pine strategy-engine
//   limitation) — for the tightest fills, still run the chart at or below
//   your fastest enabled entry timeframe.
// - "Auto (Structure)" trend detection is a simplified higher-high/higher-low
//   proxy (comparing current close to the close N bars back on that
//   timeframe), not full swing-pivot structure mapping.
// - This is now a strategy() script: each pair places real strategy.entry()/
//   strategy.exit() orders under its own ID (S1_4H_5M, S1_1H_1M, S2_1H_1M,
//   S2_4H_5M), so TradingView's Strategy Tester tab shows a real backtest —
//   equity curve, drawdown, and each pair's trades listed separately (Pine
//   tracks P&L per entry ID even though all IDs share one net position at
//   the broker level). The custom top-right table mirrors the same
//   entry/stop/target logic internally for its win-rate/drawdown display,
//   so the two should agree; the Strategy Tester additionally factors in
//   whatever commission/slippage/position size you set in the Properties
//   tab, which the custom table does not.
// - Two pairs firing in opposite directions at the same time will still net
//   against each other at the position-size/margin level (standard Pine
//   strategy behavior — one net position per symbol), even though each
//   shows as a separate trade in the trade list.
// ============================================================================
