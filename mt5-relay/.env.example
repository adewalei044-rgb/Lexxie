# Copy to .env (same folder as app.py) and fill in. Never commit .env.

# Long random string - put this in your TradingView Webhook URL as
# https://your-domain/hook/<this-value>. Generate one with (PowerShell):
#   -join ((48..57)+(97..102)|Get-Random -Count 32|%{[char]$_})
WEBHOOK_SECRET=

# Leave MT5_LOGIN/PASSWORD/SERVER blank to just use whichever account is
# already logged into the MT5 terminal running on this machine. Fill them
# in only if you want this script to log in itself.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Only needed if MT5 isn't already running - full path to terminal64.exe,
# e.g. C:\Program Files\Exness MT5 Terminal\terminal64.exe
MT5_TERMINAL_PATH=

# Some brokers (Exness included, on some account types) suffix their symbol
# names, e.g. "XAUUSDm" instead of "XAUUSD". Check your MT5 Market Watch for
# the exact symbol name and set the suffix Lexxie's plain symbol is missing.
SYMBOL_SUFFIX=

# --- Position sizing (pick ONE approach) ---

# Option A: risk a fixed amount of account currency per trade; lot size is
# derived from the entry/stop distance Lexxie sends and the symbol's tick
# value (works for forex/commodities CFDs where MT5 exposes tick value).
RISK_MONEY=0

# Option B: always trade a fixed lot size. Used only if RISK_MONEY is 0.
FIXED_LOT=0.01

# Max allowed slippage in points for market orders.
DEVIATION_POINTS=20

# Any fixed integer - lets you identify Lexxie's orders in MT5's history.
MAGIC_NUMBER=20260703

PORT=3001
