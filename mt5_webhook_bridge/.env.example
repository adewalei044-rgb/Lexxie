# Copy this file to .env and fill in real values. Never commit the real .env.

# --- MT5 terminal login (only used when DRY_RUN=false) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your-account-password
MT5_SERVER=YourBroker-Live
# Optional: full path to terminal64.exe if MT5 isn't auto-detected
MT5_TERMINAL_PATH=

# --- Webhook security ---
# Shared secret TradingView must send back. Set this to a long random
# string and put it in the alert's webhook URL as ?secret=... or have
# your reverse proxy add the X-Webhook-Secret header.
WEBHOOK_SECRET=change-me-to-a-long-random-string
PORT=5000

# --- Safety ---
# Keep this "true" until you've watched webhook_bridge.log show exactly
# the orders you expect, for every one of the four strategies, on a demo
# account. Only set to "false" to place real orders.
DRY_RUN=true

# --- Symbol mapping ---
# JSON object mapping the "symbol" field TradingView sends to whatever
# your broker actually calls it in MT5 (suffixes like .a/.c/m are common).
SYMBOL_MAP={"EURUSD": "EURUSD", "GBPUSD": "GBPUSD", "XAUUSD": "XAUUSD"}
SYMBOL_SUFFIX=

MAX_LOT_SIZE=10
DEVIATION_POINTS=20
DEFAULT_MAGIC=100099
