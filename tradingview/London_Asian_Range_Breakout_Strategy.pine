//@version=6
strategy("London Open - Asian Range Breakout Strategy",
     shorttitle = "London-Asian-Breakout",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10,
     calc_on_every_tick = true,
     process_orders_on_close = true)

// =============================================================================
// MODEL (Asian range breakout traded at the London open):
// 1) Asian range: the high/low formed during the low-liquidity Asian session
//    is tracked and locked in once that session ends.
// 2) London breakout: when the London session opens, volume and volatility
//    pick up sharply - price breaking out of the overnight Asian range at
//    that point is one of the oldest, most widely documented setups used on
//    professional and bank forex desks (the liquidity that built up
//    overnight gets run once London opens).
// 3) Optional retest: instead of chasing the breakout candle, wait for price
//    to pull back to the broken range edge and hold before entering.
// 4) Risk: stop beyond the opposite side of the range (a failed breakout
//    means price re-entered the range), target either a fixed R:R multiple
//    or the classic "measured move" - the range's own height projected from
//    the breakout point.
//
// This is built from the publicly documented Asian-range / London-open
// breakout methodology that has been written about and used by institutional
// and retail forex traders for decades - the same engineering pattern (risk
// gates, fancy table, webhook payload) used in the other strategies in this
// folder. It is NOT derived from any live broker, webhook, or third-party
// trading account - no such data source is available in this environment.
//
// WEBHOOK NOTE: Pine Script cannot call a URL directly - TradingView posts
// the alert_message JSON below to whatever "Webhook URL" you paste into the
// alert dialog when you create an alert from this strategy.
// =============================================================================

// ----------------------------------------------------------------------------
// INPUTS
// ----------------------------------------------------------------------------
grpRules        = "Step 0 - Enable / Disable Rules (for testing)"
enableRetest    = input.bool(true,  "Require Range-Edge Retest", tooltip = "On = wait for price to pull back to the broken range edge and hold before entering. Off = enter immediately on the breakout candle.", group = grpRules)
useMeasuredMove = input.bool(false, "Use Measured-Move Target",  tooltip = "Off = take profit at a fixed Reward:Risk multiple. On = take profit at the Asian range's own height projected from the breakout point (classic measured-move target).", group = grpRules)

grpSession     = "Step 1 - Asian Range + London Session"
sessionTimezone   = input.string("UTC", "Session Timezone (e.g. UTC, America/New_York)", group = grpSession)
asianSessionInput = input.session("0000-0700", "Asian Range Session Hours", tooltip = "The overnight low-liquidity session whose high/low forms the range to break.", group = grpSession)
londonSessionInput= input.session("0700-1600", "London Trading Window", tooltip = "Breakout entries are only allowed inside this window.", group = grpSession)

grpBreak              = "Step 2 - Breakout + Retest"
retestValidBars       = input.int(15, "Retest Stays Valid For (bars)", minval = 1, tooltip = "How many bars after the breakout the retest is still accepted.", group = grpBreak)
retestToleranceTicks  = input.float(5, "Retest Tolerance (ticks beyond range edge)", minval = 0, tooltip = "How far price may dip past the broken edge on the retest and still count as holding.", group = grpBreak)

grpRisk         = "Step 3 - Risk Management (SL / TP)"
rrMultiple      = input.float(2.0, "Reward : Risk Multiple (used when Measured-Move Target is Off)", step = 0.1, group = grpRisk)
slBufferTicks   = input.float(2, "Extra SL Buffer (ticks beyond range edge)", group = grpRisk)
useConfirmedBar = input.bool(true, "Only Trigger on Confirmed (Closed) Bar", tooltip = "On = waits for the bar to fully close before triggering (safer, no repaint).", group = grpRisk)

grpWebhook    = "Step 4 - Webhook Alert Payload"
webhookSymbol = input.string("", "Symbol Override for JSON (blank = chart ticker)", group = grpWebhook)
qtyForAlert   = input.float(1, "Quantity field to send in JSON", group = grpWebhook)

grpVis         = "Step 5 - Display / Visuals"
showRangeBox   = input.bool(true, "Show Asian Range Box", group = grpVis)
showTable      = input.bool(true, "Show Status Table", group = grpVis)
showTradeBoxes = input.bool(true, "Show Entry/TP/SL Boxes", group = grpVis)
boxExtendBars  = input.int(30, "Box Min Width (bars)", group = grpVis)

grpLimits = "Step 6 - Daily Trade / Loss / Drawdown Limits (Optional, all default Off)"
enableDailyLimit     = input.bool(false, "Daily Trade / Loss Limit", tooltip = "Off = no daily cap. On = blocks new entries once max trades/day or max daily loss % (from equity at day start) is hit.", group = grpLimits)
maxDailyTrades       = input.int(10, "Max Trades Per Day", minval = 1, group = grpLimits)
maxDailyLossPct      = input.float(2.0, "Max Daily Loss % (of day-start equity)", minval = 0.1, group = grpLimits)
enableDrawdownLimit  = input.bool(false, "Max Drawdown Limit", tooltip = "Off = no drawdown cap. On = blocks new entries once drawdown from peak equity exceeds this %.", group = grpLimits)
maxDrawdownPct       = input.float(20.0, "Max Drawdown % - Stop New Entries", minval = 1.0, group = grpLimits)

// ----------------------------------------------------------------------------
// 1) ASIAN RANGE TRACKING
// ----------------------------------------------------------------------------
inAsianSession  = not na(time(timeframe.period, asianSessionInput,  sessionTimezone))
inLondonSession = not na(time(timeframe.period, londonSessionInput, sessionTimezone))

newAsianSession   = inAsianSession and not inAsianSession[1]
asianSessionEnded = not inAsianSession and inAsianSession[1]

var float asianHigh       = na
var float asianLow        = na
var bool  asianRangeLocked = false

if newAsianSession
    asianHigh        := high
    asianLow         := low
    asianRangeLocked := false

if inAsianSession
    asianHigh := math.max(asianHigh, high)
    asianLow  := math.min(asianLow, low)

if asianSessionEnded
    asianRangeLocked := true

rangeValid = asianRangeLocked and not na(asianHigh) and not na(asianLow)
rangeWidth = rangeValid ? asianHigh - asianLow : 0.0

// ----------------------------------------------------------------------------
// 2) LONDON BREAKOUT + RETEST
// ----------------------------------------------------------------------------
breakoutUp   = rangeValid and inLondonSession and close > asianHigh
breakoutDown = rangeValid and inLondonSession and close < asianLow

var float longBreakoutLevel  = na
var int   longBreakoutBar    = na
var float shortBreakoutLevel = na
var int   shortBreakoutBar   = na

if breakoutUp
    longBreakoutLevel := asianHigh
    longBreakoutBar   := bar_index
if breakoutDown
    shortBreakoutLevel := asianLow
    shortBreakoutBar   := bar_index

retestLongActive  = not na(longBreakoutBar)  and (bar_index - longBreakoutBar)  <= retestValidBars
retestShortActive = not na(shortBreakoutBar) and (bar_index - shortBreakoutBar) <= retestValidBars

retestLongTouch  = retestLongActive  and low  <= longBreakoutLevel  + retestToleranceTicks * syminfo.mintick and close > longBreakoutLevel
retestShortTouch = retestShortActive and high >= shortBreakoutLevel - retestToleranceTicks * syminfo.mintick and close < shortBreakoutLevel

longTrigger  = enableRetest ? retestLongTouch  : breakoutUp
shortTrigger = enableRetest ? retestShortTouch : breakoutDown

// ----------------------------------------------------------------------------
// 2B) DAILY / DRAWDOWN RISK LIMITS (Step 6 inputs - all default Off, so
//     existing behavior is unaffected unless one is switched on)
// ----------------------------------------------------------------------------
newDay = ta.change(dayofmonth(time)) != 0
var float dayStartEquity = strategy.initial_capital
var int   dayTradeCount  = 0
if newDay
    dayStartEquity := strategy.equity
    dayTradeCount  := 0

dailyLossPct = dayStartEquity > 0 ? (dayStartEquity - strategy.equity) / dayStartEquity * 100.0 : 0.0
dailyLimitOk = not enableDailyLimit or (dayTradeCount < maxDailyTrades and dailyLossPct < maxDailyLossPct)

var float peakEquity = strategy.initial_capital
peakEquity := math.max(peakEquity, strategy.equity)
drawdownPct = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100.0 : 0.0
drawdownOk = not enableDrawdownLimit or drawdownPct < maxDrawdownPct

riskGateOk = dailyLimitOk and drawdownOk

// ----------------------------------------------------------------------------
// 3) ENTRY SIGNAL
// ----------------------------------------------------------------------------
barGate = useConfirmedBar ? barstate.isconfirmed : true

longSignal  = inLondonSession and longTrigger  and barGate and riskGateOk and strategy.position_size <= 0
shortSignal = inLondonSession and shortTrigger and barGate and riskGateOk and strategy.position_size >= 0

// ----------------------------------------------------------------------------
// 4) RISK MANAGEMENT + WEBHOOK ALERT PAYLOADS
// ----------------------------------------------------------------------------
webhookSymbolStr = webhookSymbol == "" ? syminfo.ticker : webhookSymbol

var box   profitBox  = na
var box   riskBox    = na
var label entryLabel = na

drawTradeVisuals(isLong, entryPrice, sl, tp) =>
    box.delete(profitBox)
    box.delete(riskBox)
    label.delete(entryLabel)
    rightBar     = bar_index + boxExtendBars
    profitTop    = isLong ? tp : entryPrice
    profitBottom = isLong ? entryPrice : tp
    riskTop      = isLong ? entryPrice : sl
    riskBottom   = isLong ? sl : entryPrice
    newProfitBox = box.new(bar_index, profitTop, rightBar, profitBottom, border_color = color.green, bgcolor = color.new(color.green, 85))
    newRiskBox   = box.new(bar_index, riskTop, rightBar, riskBottom, border_color = color.red, bgcolor = color.new(color.red, 85))
    newLabel     = label.new(bar_index, isLong ? entryPrice - (tp - entryPrice) * 0.1 : entryPrice + (entryPrice - tp) * 0.1,
         isLong ? "BUY" : "SELL",
         style = isLong ? label.style_label_up : label.style_label_down,
         color = isLong ? color.green : color.red, textcolor = color.white, size = size.small)
    [newProfitBox, newRiskBox, newLabel]

if longSignal
    slPrice = asianLow - slBufferTicks * syminfo.mintick
    risk    = close - slPrice
    tpPrice = useMeasuredMove ? close + rangeWidth : close + risk * rrMultiple
    longMsg = "{\"action\":\"buy\",\"symbol\":\"" + webhookSymbolStr + "\",\"side\":\"long\",\"price\":" + str.tostring(close) + ",\"sl\":" + str.tostring(slPrice) + ",\"tp\":" + str.tostring(tpPrice) + ",\"qty\":" + str.tostring(qtyForAlert) + ",\"strategy\":\"London-Asian-Breakout\",\"time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ") + "\"}"
    exitMsg = "{\"action\":\"close\",\"symbol\":\"" + webhookSymbolStr + "\",\"side\":\"long\",\"strategy\":\"London-Asian-Breakout\"}"
    strategy.entry("Long", strategy.long, alert_message = longMsg)
    strategy.exit("Long Exit", from_entry = "Long", stop = slPrice, limit = tpPrice, alert_message = exitMsg)
    dayTradeCount := dayTradeCount + 1
    if showTradeBoxes
        [pb, rb, el] = drawTradeVisuals(true, close, slPrice, tpPrice)
        profitBox  := pb
        riskBox    := rb
        entryLabel := el
    else
        label.new(bar_index, low, "BUY", style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)

if shortSignal
    slPrice = asianHigh + slBufferTicks * syminfo.mintick
    risk    = slPrice - close
    tpPrice = useMeasuredMove ? close - rangeWidth : close - risk * rrMultiple
    shortMsg = "{\"action\":\"sell\",\"symbol\":\"" + webhookSymbolStr + "\",\"side\":\"short\",\"price\":" + str.tostring(close) + ",\"sl\":" + str.tostring(slPrice) + ",\"tp\":" + str.tostring(tpPrice) + ",\"qty\":" + str.tostring(qtyForAlert) + ",\"strategy\":\"London-Asian-Breakout\",\"time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ") + "\"}"
    exitMsg = "{\"action\":\"close\",\"symbol\":\"" + webhookSymbolStr + "\",\"side\":\"short\",\"strategy\":\"London-Asian-Breakout\"}"
    strategy.entry("Short", strategy.short, alert_message = shortMsg)
    strategy.exit("Short Exit", from_entry = "Short", stop = slPrice, limit = tpPrice, alert_message = exitMsg)
    dayTradeCount := dayTradeCount + 1
    if showTradeBoxes
        [pb, rb, el] = drawTradeVisuals(false, close, slPrice, tpPrice)
        profitBox  := pb
        riskBox    := rb
        entryLabel := el
    else
        label.new(bar_index, high, "SELL", style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)

if showTradeBoxes and strategy.position_size != 0 and not na(profitBox)
    box.set_right(profitBox, math.max(bar_index, box.get_right(profitBox)))
    box.set_right(riskBox, math.max(bar_index, box.get_right(riskBox)))

// ----------------------------------------------------------------------------
// 5) VISUALS + DIAGNOSTICS
// ----------------------------------------------------------------------------
var box rangeBox = na

if showRangeBox
    if newAsianSession
        box.delete(rangeBox)
        rangeBox := box.new(bar_index, asianHigh, bar_index, asianLow, border_color = color.orange, bgcolor = color.new(color.orange, 88))
    if inAsianSession and not na(rangeBox)
        box.set_top(rangeBox, asianHigh)
        box.set_bottom(rangeBox, asianLow)
        box.set_right(rangeBox, bar_index)
    if asianRangeLocked and not inAsianSession and not na(rangeBox)
        box.set_right(rangeBox, bar_index)

plotshape(longSignal  ? low  : na, "Buy Entry Logo",  style = shape.labelup,   location = location.belowbar, color = color.lime, size = size.small, text = "BUY",  textcolor = color.black)
plotshape(shortSignal ? high : na, "Sell Entry Logo", style = shape.labeldown, location = location.abovebar, color = color.red,  size = size.small, text = "SELL", textcolor = color.white)

winTrades   = strategy.wintrades
lossTrades  = strategy.losstrades
totalClosed = strategy.closedtrades
winPct = totalClosed > 0 ? (winTrades / totalClosed) * 100.0 : 0.0

currentDateStr = str.format_time(time, "yyyy-MM-dd")
var string lastDateStr     = na
var int    dailyWin        = 0
var int    dailyLoss       = 0
var int    prevClosedCount = 0
if na(lastDateStr) or currentDateStr != lastDateStr
    dailyWin    := 0
    dailyLoss   := 0
    lastDateStr := currentDateStr

winBoxHeight = ta.atr(14) * 0.3

if totalClosed > prevClosedCount
    lastTradeProfit = strategy.closedtrades.profit(totalClosed - 1)
    exitBar   = strategy.closedtrades.exit_bar_index(totalClosed - 1)
    exitPrice = strategy.closedtrades.exit_price(totalClosed - 1)
    if lastTradeProfit > 0
        dailyWin := dailyWin + 1
        if showTradeBoxes
            box.new(exitBar - 2, exitPrice + winBoxHeight, exitBar + 2, exitPrice - winBoxHeight, border_color = color.lime, bgcolor = color.new(color.lime, 80))
            label.new(exitBar, exitPrice + winBoxHeight * 1.5, "WIN", style = label.style_label_down, color = color.lime, textcolor = color.black, size = size.small)
    else
        dailyLoss := dailyLoss + 1
    prevClosedCount := totalClosed

var int breakoutCount = 0
if breakoutUp or breakoutDown
    breakoutCount := breakoutCount + 1

var int retestCount = 0
if retestLongTouch or retestShortTouch
    retestCount := retestCount + 1

titleBg     = color.rgb(20, 22, 38)
titleText   = color.rgb(255, 205, 60)
labelBg     = color.rgb(32, 35, 52)
labelText   = color.rgb(190, 198, 220)
neutralBg   = color.rgb(45, 50, 75)
winRateBg   = color.rgb(10, 95, 145)
winBg       = color.rgb(15, 120, 80)
lossBg      = color.rgb(160, 35, 45)
dailyWinBg  = color.rgb(25, 150, 100)
dailyLossBg = color.rgb(190, 60, 60)
drawdownBg  = color.rgb(195, 120, 15)

if showTable
    var table statusTbl = table.new(position.top_right, 2, 10, border_width = 2, border_color = color.rgb(255, 205, 60))
    if barstate.islast
        table.cell(statusTbl, 0, 0, "STRATEGY STATS", bgcolor = titleBg, text_color = titleText, text_size = size.normal)
        table.cell(statusTbl, 1, 0, "", bgcolor = titleBg)
        table.cell(statusTbl, 0, 1, "Win Rate", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 1, str.tostring(winPct, "#.##") + "%", text_color = color.white, bgcolor = winRateBg)
        table.cell(statusTbl, 0, 2, "Win", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 2, str.tostring(winTrades), text_color = color.white, bgcolor = winBg)
        table.cell(statusTbl, 0, 3, "Loss", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 3, str.tostring(lossTrades), text_color = color.white, bgcolor = lossBg)
        table.cell(statusTbl, 0, 4, "Daily Win", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 4, str.tostring(dailyWin), text_color = color.white, bgcolor = dailyWinBg)
        table.cell(statusTbl, 0, 5, "Daily Loss", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 5, str.tostring(dailyLoss), text_color = color.white, bgcolor = dailyLossBg)
        table.cell(statusTbl, 0, 6, "Drawdown", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 6, str.tostring(drawdownPct, "#.##") + "%", text_color = color.white, bgcolor = drawdownBg)
        table.cell(statusTbl, 0, 7, "Asian Range (pts)", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 7, str.tostring(rangeWidth, format.mintick), text_color = color.white, bgcolor = neutralBg)
        table.cell(statusTbl, 0, 8, "Breakouts", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 8, str.tostring(breakoutCount), text_color = color.white, bgcolor = neutralBg)
        table.cell(statusTbl, 0, 9, "Retest Touches", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 9, str.tostring(retestCount), text_color = color.white, bgcolor = neutralBg)
