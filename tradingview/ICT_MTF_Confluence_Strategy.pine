//@version=6
strategy("ICT MTF Confluence Strategy (4H Trend / 1H Gann Zone / 1m-5m FVG)",
     shorttitle = "ICT-MTF-Confluence",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10,
     calc_on_every_tick = true,
     process_orders_on_close = true)

// =============================================================================
// Run this script on a 1-minute chart. All higher timeframes are pulled
// explicitly via request.security(), so the logic is correct regardless of
// the chart's own timeframe, but the 1m entry trigger assumes a 1m chart.
//
// WEBHOOK NOTE: Pine Script cannot call a URL directly — TradingView posts
// the alert_message JSON below to whatever "Webhook URL" you paste into the
// alert dialog when you create an alert from this strategy. Set that up in
// TradingView: Create Alert -> Condition: this strategy -> check "Webhook
// URL" -> paste your receiver's URL. The JSON payloads are built below.
// =============================================================================

// ----------------------------------------------------------------------------
// INPUTS — grouped in the same order as the trading model steps below.
// Tap the (i) icon next to any setting in TradingView for a plain-English
// explanation of what it does and which direction loosens vs. tightens it.
// ----------------------------------------------------------------------------
grpRules             = "Step 0 - Enable / Disable Rules (for testing)"
enableTrendFilter    = input.bool(true, "4H Trend Filter",               tooltip = "Off = ignore the 4H trend direction entirely; long and short setups both become available regardless of trend.", group = grpRules)
enableMomentumShift  = input.bool(true, "1H Momentum Body Shift",        tooltip = "Off = ignore the 1H momentum candle (body-shift) requirement.", group = grpRules)
enableGannZone       = input.bool(true, "1H Gann Box Zone",              tooltip = "Off = ignore the 1H Gann retracement zone, both for 'price is in the zone right now' and for the FVG-vs-zone overlap check used inside FVG confluence.", group = grpRules)
enableStopHunt       = input.bool(true, "1m Stop Hunt / Liquidity Sweep",tooltip = "Off = ignore the stop-hunt/liquidity-sweep requirement.", group = grpRules)
enableFVGConfluence  = input.bool(true, "1m/5m FVG Confluence",          tooltip = "Off = ignore the requirement that the 1m FVG also overlaps a confluent 5m FVG. The 1m FVG itself is still required as the entry zone (rejection still needs a zone to wick into).", group = grpRules)
enableRejectionWick  = input.bool(true, "Rejection Candle Wick",         tooltip = "Off = ignore the wick-to-body ratio and close-direction requirement. Price still has to wick into the FVG zone, it just no longer needs the rejection wick/close shape.", group = grpRules)

grpTrend = "Step 1 - Trend Filter (4H)"
maLen    = input.int(200, "MA Length", tooltip = "How many 4H candles the trend average uses. Smaller = trend flips more often (more setups, less reliable). Larger = stricter trend, fewer setups.", group = grpTrend)
maType   = input.string("EMA", "MA Type", options = ["EMA", "SMA"], tooltip = "EMA reacts faster to recent price than SMA.", group = grpTrend)
trendTF  = input.timeframe("240", "Trend Timeframe", tooltip = "Timeframe used for the trend filter. Default 240 = 4 hours.", group = grpTrend)

grp1h        = "Step 2 - Momentum + Entry Zone (1H)"
htfTF        = input.timeframe("60", "1H Signal Timeframe", tooltip = "Timeframe used for momentum and the Gann box zone. Default 60 = 1 hour.", group = grp1h)
longZoneLowPct  = input.float(0.38,  "Long Zone Low (0-1 of candle range)",  step = 0.01, tooltip = "Bottom edge of the pullback zone for longs, as a fraction of the 1H candle's range. Widen this range (lower this, raise the High) to make price qualify more often.", group = grp1h)
longZoneHighPct = input.float(0.88, "Long Zone High (0-1 of candle range)", step = 0.01, tooltip = "Top edge of the pullback zone for longs.", group = grp1h)
shortZoneLowPct = input.float(0.12, "Short Zone Low (0-1 of candle range)", step = 0.01, tooltip = "Bottom edge of the pullback zone for shorts.", group = grp1h)
shortZoneHighPct= input.float(0.62,  "Short Zone High (0-1 of candle range)",step = 0.01, tooltip = "Top edge of the pullback zone for shorts. Widen this range to make price qualify more often.", group = grp1h)
momentumOverlapPct = input.float(0.5, "Momentum Overlap Tolerance (0=strict no overlap)", minval = 0.0, maxval = 0.9, step = 0.05, tooltip = "0 = the 1H candle body must be fully clear of the prior candle's body (strictest). Raising this toward 0.9 allows more overlap, so momentum shifts trigger more easily.", group = grp1h)

grpHunt       = "Step 3 - Stop Hunt (1m)"
huntLookback  = input.int(20, "Swing Lookback (bars)", tooltip = "How many bars back to look for the swing high/low that price must sweep. Raising this finds sweeps more often.", group = grpHunt)
huntValidBars = input.int(30, "Stop Hunt Stays Valid For (bars)", tooltip = "How many bars after a sweep the setup stays eligible. Raising this gives more time for the rest of the confluence to line up.", group = grpHunt)

grpFVG        = "Step 4 - Fair Value Gap Confluence (1m + 5m)"
ltfFVGTF      = input.timeframe("1", "Entry FVG Timeframe", tooltip = "Timeframe used for the entry-trigger FVG. Default 1 = 1 minute.", group = grpFVG)
htfFVGTF      = input.timeframe("5", "Confluence FVG Timeframe", tooltip = "Timeframe used for the confirming FVG. Default 5 = 5 minutes.", group = grpFVG)
fvgMaxAge     = input.int(100, "Max FVG / Stop-Hunt Age (bars)", tooltip = "How many bars an FVG stays usable after it forms. Raising this keeps gaps active longer, increasing the chance of a match.", group = grpFVG)
fvgMaxActive  = input.int(40, "Max Tracked FVGs per Timeframe", tooltip = "How many recent gaps are remembered at once. Raising this tracks more gaps simultaneously.", group = grpFVG)
fvgOverlapBufferPct = input.float(2.0, "Overlap Tolerance (x each zone's own size)", minval = 0.0, step = 0.25, tooltip = "Requiring the 1m FVG, the Gann zone, and the 5m FVG to literally overlap in price is very strict — true gaps rarely line up to the exact cent across three different bands. This pads each side of the Gann-zone and 5m-FVG checks by this multiple of that zone's own size before testing overlap, so near-misses still count as confluence. 0 = exact overlap only (original strict rule, may produce 0 trades). Raise this if 'FVG Confluences' stays at 0.", group = grpFVG)

grpReject     = "Step 5 - Entry Trigger (Rejection Candle)"
rejWickFactor = input.float(1.0, "Min Wick-to-Body Ratio", step = 0.1, tooltip = "How much bigger the rejecting wick must be than the candle body. Lowering toward 1.0 makes the trigger easier to satisfy.", group = grpReject)

grpRisk       = "Step 6 - Risk Management (SL / TP)"
rrMultiple    = input.float(2.0, "Reward : Risk Multiple", step = 0.1, tooltip = "Take-profit distance as a multiple of the stop-loss distance, e.g. 2.0 = TP is 2x further than SL.", group = grpRisk)
slBufferTicks = input.float(2, "Extra SL Buffer (ticks beyond hunt wick)", tooltip = "Extra cushion added beyond the stop-hunt wick when placing the stop-loss.", group = grpRisk)
useConfirmedBar = input.bool(true, "Only Trigger on Confirmed (Closed) Bar", tooltip = "On = waits for the bar to fully close before triggering (safer, no repaint). Off = can trigger mid-bar (more signals, but the trigger bar can repaint).", group = grpRisk)

grpWebhook    = "Step 7 - Webhook Alert Payload"
webhookSymbol = input.string("", "Symbol Override for JSON (blank = chart ticker)", tooltip = "Leave blank to use the chart's own ticker in the alert JSON, or type a custom symbol name to send instead.", group = grpWebhook)
qtyForAlert   = input.float(1, "Quantity field to send in JSON", tooltip = "The qty value sent in the webhook JSON payload — for your receiving bot to read, does not affect this strategy's backtest sizing.", group = grpWebhook)

grpVis        = "Step 8 - Display / Visuals"
showZoneLines = input.bool(true, "Show Gann Zone Lines", tooltip = "Plot the long/short pullback zone lines on the chart.", group = grpVis)
showTable     = input.bool(true, "Show Status Table", tooltip = "Show the on-chart table with win rate, stage status, and diagnostic counters.", group = grpVis)
showTradeBoxes= input.bool(true, "Show Entry/TP/SL Boxes", tooltip = "Draw colored profit/risk boxes on each trade instead of a plain label.", group = grpVis)
boxExtendBars = input.int(30, "Box Min Width (bars)", tooltip = "Minimum width (in bars) of the trade boxes drawn on entry.", group = grpVis)

// ----------------------------------------------------------------------------
// 1) 4H TREND FILTER
// ----------------------------------------------------------------------------
get_ma() =>
    maType == "EMA" ? ta.ema(close, maLen) : ta.sma(close, maLen)

htfClose = request.security(syminfo.tickerid, trendTF, close[1], lookahead = barmerge.lookahead_off)
htfMA    = request.security(syminfo.tickerid, trendTF, get_ma()[1], lookahead = barmerge.lookahead_off)

trendBullish = htfClose > htfMA
trendBearish = htfClose < htfMA

// ----------------------------------------------------------------------------
// 2) 1H MOMENTUM CANDLE + GANN BOX RETRACEMENT ZONE
// ----------------------------------------------------------------------------
h1Open  = request.security(syminfo.tickerid, htfTF, open[1],  lookahead = barmerge.lookahead_off)
h1High  = request.security(syminfo.tickerid, htfTF, high[1],  lookahead = barmerge.lookahead_off)
h1Low   = request.security(syminfo.tickerid, htfTF, low[1],   lookahead = barmerge.lookahead_off)
h1Close = request.security(syminfo.tickerid, htfTF, close[1], lookahead = barmerge.lookahead_off)
h2Open  = request.security(syminfo.tickerid, htfTF, open[2],  lookahead = barmerge.lookahead_off)
h2High  = request.security(syminfo.tickerid, htfTF, high[2],  lookahead = barmerge.lookahead_off)
h2Low   = request.security(syminfo.tickerid, htfTF, low[2],   lookahead = barmerge.lookahead_off)
h2Close = request.security(syminfo.tickerid, htfTF, close[2], lookahead = barmerge.lookahead_off)

h1BodyHigh = math.max(h1Open, h1Close)
h1BodyLow  = math.min(h1Open, h1Close)
h2BodyHigh = math.max(h2Open, h2Close)
h2BodyLow  = math.min(h2Open, h2Close)
h2BodySize = h2BodyHigh - h2BodyLow

// momentumOverlapPct = 0 reproduces the original strict "body fully above/
// below prior body" rule; >0 allows that fraction of the prior body's size
// to overlap so momentum shifts aren't disqualified by a sliver of overlap.
bullishBodyShift = h1BodyLow  > h2BodyHigh - momentumOverlapPct * h2BodySize   // 1H candle body above prior candle's body (tolerance-adjusted)
bearishBodyShift = h1BodyHigh < h2BodyLow + momentumOverlapPct * h2BodySize   // 1H candle body below prior candle's body (tolerance-adjusted)

h1Range = h1High - h1Low
longZoneLow   = h1Low + longZoneLowPct   * h1Range
longZoneHigh  = h1Low + longZoneHighPct  * h1Range
shortZoneLow  = h1Low + shortZoneLowPct  * h1Range
shortZoneHigh = h1Low + shortZoneHighPct * h1Range

priceInLongZone  = low  <= longZoneHigh  and high >= longZoneLow
priceInShortZone = high >= shortZoneLow  and low  <= shortZoneHigh

longSetupActive  = trendBullish and bullishBodyShift and priceInLongZone
shortSetupActive = trendBearish and bearishBodyShift and priceInShortZone

// ----------------------------------------------------------------------------
// 3) 1m STOP HUNT (liquidity sweep + reclaim)
// ----------------------------------------------------------------------------
swingLow  = ta.lowest(low,  huntLookback)[1]
swingHigh = ta.highest(high, huntLookback)[1]

stopHuntLongRaw  = low  < swingLow  and close > swingLow
stopHuntShortRaw = high > swingHigh and close < swingHigh

var int   lastLongHuntBar   = na
var float lastLongHuntLow   = na
var int   lastShortHuntBar  = na
var float lastShortHuntHigh = na

if stopHuntLongRaw
    lastLongHuntBar  := bar_index
    lastLongHuntLow  := low
if stopHuntShortRaw
    lastShortHuntBar  := bar_index
    lastShortHuntHigh := high

stopHuntLongActive  = not na(lastLongHuntBar)  and (bar_index - lastLongHuntBar)  <= huntValidBars
stopHuntShortActive = not na(lastShortHuntBar) and (bar_index - lastShortHuntBar) <= huntValidBars

// ----------------------------------------------------------------------------
// 4) FVG TRACKING (1m entry timeframe + 5m confluence timeframe)
// ----------------------------------------------------------------------------
trackFVG(tf, maxCount, topArr, botArr, bullArr, barArr) =>
    h1 = request.security(syminfo.tickerid, tf, high[1], lookahead = barmerge.lookahead_off)
    h3 = request.security(syminfo.tickerid, tf, high[3], lookahead = barmerge.lookahead_off)
    l1 = request.security(syminfo.tickerid, tf, low[1],  lookahead = barmerge.lookahead_off)
    l3 = request.security(syminfo.tickerid, tf, low[3],  lookahead = barmerge.lookahead_off)
    t1 = request.security(syminfo.tickerid, tf, time[1], lookahead = barmerge.lookahead_off)

    var int lastClosedTime = na
    isNewClose = t1 != lastClosedTime

    bull = l1 > h3
    bear = h1 < l3

    if isNewClose
        lastClosedTime := t1
        if bull
            array.push(topArr, l1)
            array.push(botArr, h3)
            array.push(bullArr, true)
            array.push(barArr, bar_index)
        if bear
            array.push(topArr, l3)
            array.push(botArr, h1)
            array.push(bullArr, false)
            array.push(barArr, bar_index)
        while array.size(topArr) > maxCount
            array.shift(topArr)
            array.shift(botArr)
            array.shift(bullArr)
            array.shift(barArr)

var float[] ltfTop  = array.new<float>()
var float[] ltfBot  = array.new<float>()
var bool[]  ltfBull = array.new<bool>()
var int[]   ltfBar  = array.new<int>()

var float[] htfTop  = array.new<float>()
var float[] htfBot  = array.new<float>()
var bool[]  htfBull = array.new<bool>()
var int[]   htfBar  = array.new<int>()

trackFVG(ltfFVGTF, fvgMaxActive, ltfTop, ltfBot, ltfBull, ltfBar)
trackFVG(htfFVGTF, fvgMaxActive, htfTop, htfBot, htfBull, htfBar)

// ----------------------------------------------------------------------------
// 5) CONFLUENCE + REJECTION CANDLE -> SETUP FINDER
//    Default confluence rule: 1m FVG price range overlaps an active 5m FVG.
//    Also requires the 1m FVG to overlap the 1H Gann box retracement zone,
//    so the trade fires exactly at the level defined in step 2/3.
//    fvgOverlapBufferPct pads both of those overlap checks so near-misses
//    between the three narrow bands still register as confluence.
// ----------------------------------------------------------------------------
findSetup(isBull, gannLow, gannHigh, enableGann, enableHtfConf, enableRej) =>
    body      = math.abs(close - open)
    lowerWick = math.min(open, close) - low
    upperWick = high - math.max(open, close)

    foundTop = float(na)
    foundBot = float(na)
    found    = false
    dirMatch = false   // diagnostic: at least one FVG in the right direction within age limit
    gannHit  = false   // diagnostic: that FVG also overlaps the Gann zone
    htfHit   = false   // diagnostic: gann-matched FVG also overlaps a confluent HTF FVG
    touchHit = false   // diagnostic: price has wicked back into a fully-confluent FVG zone

    n = array.size(ltfTop)
    if n > 0
        for i = 0 to n - 1
            if array.get(ltfBull, i) == isBull and (bar_index - array.get(ltfBar, i)) <= fvgMaxAge
                dirMatch := true
                t1 = array.get(ltfTop, i)
                b1 = array.get(ltfBot, i)
                gannPad = (gannHigh - gannLow) * fvgOverlapBufferPct
                gannOverlap = math.max(b1, gannLow - gannPad) <= math.min(t1, gannHigh + gannPad)
                if gannOverlap
                    gannHit := true
                // enableGann off bypasses the Gann-zone overlap requirement (diagnostic gannHit stays raw above)
                if gannOverlap or not enableGann
                    conf = false
                    m = array.size(htfTop)
                    if m > 0
                        for j = 0 to m - 1
                            if array.get(htfBull, j) == isBull and (bar_index - array.get(htfBar, j)) <= fvgMaxAge
                                t5 = array.get(htfTop, j)
                                b5 = array.get(htfBot, j)
                                pad5 = (t5 - b5) * fvgOverlapBufferPct
                                if math.max(b1, b5 - pad5) <= math.min(t1, t5 + pad5)
                                    conf := true
                    if conf
                        htfHit := true
                    // enableHtfConf off bypasses the 5m-FVG-confluence requirement (1m FVG zone is still required)
                    if conf or not enableHtfConf
                        touched = low <= t1 and high >= b1
                        if touched
                            touchHit := true
                        rej = enableRej ?
                             (isBull ?
                                 (close > open and lowerWick >= body * rejWickFactor and touched) :
                                 (close < open and upperWick >= body * rejWickFactor and touched)) :
                             touched
                        if rej
                            found    := true
                            foundTop := t1
                            foundBot := b1
    [found, foundTop, foundBot, dirMatch, gannHit, htfHit, touchHit]

[longFVGFound,  longFvgTop,  longFvgBot,  longDirMatch,  longGannHit,  longHtfHit,  longTouchHit]  = findSetup(true,  longZoneLow,  longZoneHigh, enableGannZone, enableFVGConfluence, enableRejectionWick)
[shortFVGFound, shortFvgTop, shortFvgBot, shortDirMatch, shortGannHit, shortHtfHit, shortTouchHit] = findSetup(false, shortZoneLow, shortZoneHigh, enableGannZone, enableFVGConfluence, enableRejectionWick)

barGate = useConfirmedBar ? barstate.isconfirmed : true

// Each "not enableX or ..." term bypasses (always passes) that stage when its
// Step 0 toggle is off. With all toggles at their default (true), this is
// exactly equivalent to the original longSetupActive/shortSetupActive +
// stopHuntLongActive/stopHuntShortActive gating — zero behavior change.
longSignal  = (not enableTrendFilter or trendBullish) and (not enableMomentumShift or bullishBodyShift) and (not enableGannZone or priceInLongZone) and (not enableStopHunt or stopHuntLongActive) and longFVGFound and barGate and strategy.position_size <= 0
shortSignal = (not enableTrendFilter or trendBearish) and (not enableMomentumShift or bearishBodyShift) and (not enableGannZone or priceInShortZone) and (not enableStopHunt or stopHuntShortActive) and shortFVGFound and barGate and strategy.position_size >= 0

// ----------------------------------------------------------------------------
// 6) RISK MANAGEMENT + WEBHOOK ALERT PAYLOADS
// ----------------------------------------------------------------------------
webhookSymbolStr = webhookSymbol == "" ? syminfo.ticker : webhookSymbol

var box   profitBox  = na
var box   riskBox    = na
var label entryLabel = na

drawTradeVisuals(isLong, entryPrice, sl, tp) =>
    box.delete(profitBox)
    box.delete(riskBox)
    label.delete(entryLabel)
    rightBar     = bar_index + boxExtendBars
    profitTop    = isLong ? tp : entryPrice
    profitBottom = isLong ? entryPrice : tp
    riskTop      = isLong ? entryPrice : sl
    riskBottom   = isLong ? sl : entryPrice
    newProfitBox = box.new(bar_index, profitTop, rightBar, profitBottom, border_color = color.green, bgcolor = color.new(color.green, 85))
    newRiskBox   = box.new(bar_index, riskTop, rightBar, riskBottom, border_color = color.red, bgcolor = color.new(color.red, 85))
    newLabel     = label.new(bar_index, entryPrice,
         str.format("{0}\nEntry {1}\nTP {2}\nSL {3}\nR:R 1:{4}", isLong ? "BUY" : "SELL", entryPrice, tp, sl, rrMultiple),
         style = isLong ? label.style_label_up : label.style_label_down,
         color = isLong ? color.green : color.red, textcolor = color.white, size = size.small)
    [newProfitBox, newRiskBox, newLabel]

if longSignal
    // When "1m Stop Hunt" (Step 0) is off, a signal can fire with no actual
    // hunt ever recorded, leaving lastLongHuntLow na — fall back to the
    // recent swing low so the SL is never computed from na.
    slRefLong = na(lastLongHuntLow) ? swingLow : lastLongHuntLow
    slPrice = slRefLong - slBufferTicks * syminfo.mintick
    risk    = close - slPrice
    tpPrice = close + risk * rrMultiple
    longMsg = str.format(
         '{{"action":"buy","symbol":"{0}","side":"long","price":{1},"sl":{2},"tp":{3},"qty":{4},"strategy":"ICT-MTF-Confluence","time":"{5}"}}',
         webhookSymbolStr, close, slPrice, tpPrice, qtyForAlert, str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ"))
    exitMsg = str.format(
         '{{"action":"close","symbol":"{0}","side":"long","strategy":"ICT-MTF-Confluence"}}', webhookSymbolStr)
    strategy.entry("Long", strategy.long, alert_message = longMsg)
    strategy.exit("Long Exit", from_entry = "Long", stop = slPrice, limit = tpPrice, alert_message = exitMsg)
    if showTradeBoxes
        [pb, rb, el] = drawTradeVisuals(true, close, slPrice, tpPrice)
        profitBox  := pb
        riskBox    := rb
        entryLabel := el
    else
        label.new(bar_index, low, "BUY", style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)

if shortSignal
    // Same na fallback as the long side, for when Stop Hunt is off.
    slRefShort = na(lastShortHuntHigh) ? swingHigh : lastShortHuntHigh
    slPrice = slRefShort + slBufferTicks * syminfo.mintick
    risk    = slPrice - close
    tpPrice = close - risk * rrMultiple
    shortMsg = str.format(
         '{{"action":"sell","symbol":"{0}","side":"short","price":{1},"sl":{2},"tp":{3},"qty":{4},"strategy":"ICT-MTF-Confluence","time":"{5}"}}',
         webhookSymbolStr, close, slPrice, tpPrice, qtyForAlert, str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ"))
    exitMsg = str.format(
         '{{"action":"close","symbol":"{0}","side":"short","strategy":"ICT-MTF-Confluence"}}', webhookSymbolStr)
    strategy.entry("Short", strategy.short, alert_message = shortMsg)
    strategy.exit("Short Exit", from_entry = "Short", stop = slPrice, limit = tpPrice, alert_message = exitMsg)
    if showTradeBoxes
        [pb, rb, el] = drawTradeVisuals(false, close, slPrice, tpPrice)
        profitBox  := pb
        riskBox    := rb
        entryLabel := el
    else
        label.new(bar_index, high, "SELL", style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)

if showTradeBoxes and strategy.position_size != 0 and not na(profitBox)
    box.set_right(profitBox, math.max(bar_index, box.get_right(profitBox)))
    box.set_right(riskBox, math.max(bar_index, box.get_right(riskBox)))

// ----------------------------------------------------------------------------
// 7) VISUALS
// ----------------------------------------------------------------------------
plot(showZoneLines and trendBullish ? longZoneLow  : na, "Long Zone Low",  color.new(color.lime, 0),  style = plot.style_linebr)
plot(showZoneLines and trendBullish ? longZoneHigh : na, "Long Zone High", color.new(color.lime, 0),  style = plot.style_linebr)
plot(showZoneLines and trendBearish ? shortZoneLow  : na, "Short Zone Low",  color.new(color.red, 0), style = plot.style_linebr)
plot(showZoneLines and trendBearish ? shortZoneHigh : na, "Short Zone High", color.new(color.red, 0), style = plot.style_linebr)

winTrades  = strategy.wintrades
lossTrades = strategy.losstrades
totalClosed = strategy.closedtrades
winPct = totalClosed > 0 ? (winTrades / totalClosed) * 100.0 : 0.0

var float peakEquity     = strategy.initial_capital
var float maxDrawdownVal = 0.0
peakEquity := math.max(peakEquity, strategy.equity)
currentDrawdown = peakEquity - strategy.equity
maxDrawdownVal := math.max(maxDrawdownVal, currentDrawdown)
maxDrawdownPct = peakEquity > 0 ? (maxDrawdownVal / peakEquity) * 100.0 : 0.0

currentTimeStr = str.format_time(time, "yyyy-MM-dd HH:mm")

// Diagnostic counters: how many bars/events satisfied each stage of the
// confluence chain since the strategy started. Use these to find which
// condition is the bottleneck if 0 trades are firing.
var int totalBars       = 0
var int trendBars       = 0
var int momentumEvents  = 0
var int zoneTouchBars   = 0
var int stopHuntEvents  = 0
var int fvgConfluences  = 0
var int fvgDirMatches   = 0   // an active FVG existed in the right direction
var int fvgGannHits     = 0   // that FVG also overlapped the Gann zone
var int fvgHtfHits      = 0   // gann-matched FVG also overlapped a confluent HTF FVG
var int fvgTouchHits    = 0   // price wicked back into a fully-confluent FVG zone

totalBars := totalBars + 1
if trendBullish or trendBearish
    trendBars := trendBars + 1
if bullishBodyShift or bearishBodyShift
    momentumEvents := momentumEvents + 1
if priceInLongZone or priceInShortZone
    zoneTouchBars := zoneTouchBars + 1
if stopHuntLongRaw or stopHuntShortRaw
    stopHuntEvents := stopHuntEvents + 1
if longFVGFound or shortFVGFound
    fvgConfluences := fvgConfluences + 1
if longDirMatch or shortDirMatch
    fvgDirMatches := fvgDirMatches + 1
if longGannHit or shortGannHit
    fvgGannHits := fvgGannHits + 1
if longHtfHit or shortHtfHit
    fvgHtfHits := fvgHtfHits + 1
if longTouchHit or shortTouchHit
    fvgTouchHits := fvgTouchHits + 1

chartTFOk = timeframe.period == ltfFVGTF

if showTable
    var table statusTbl = table.new(position.top_right, 2, 23, border_width = 1)
    if barstate.islast
        table.cell(statusTbl, 0, 0, "Chart TF Match", bgcolor = chartTFOk ? color.gray : color.red, text_color = color.white)
        table.cell(statusTbl, 1, 0, chartTFOk ? "OK (" + timeframe.period + ")" : "MISMATCH! Chart=" + timeframe.period + " Entry TF=" + ltfFVGTF, text_color = color.white, bgcolor = chartTFOk ? color.new(color.green, 60) : color.new(color.red, 40))
        table.cell(statusTbl, 0, 1, "Win Rate",      bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 1, str.tostring(winPct, "#.##") + "%", text_color = color.white, bgcolor = color.new(color.blue, 60))
        table.cell(statusTbl, 0, 2, "Time",          bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 2, currentTimeStr,  text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 3, "Win Trades",    bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 3, str.tostring(winTrades), text_color = color.white, bgcolor = color.new(color.green, 60))
        table.cell(statusTbl, 0, 4, "Loss Trades",   bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 4, str.tostring(lossTrades), text_color = color.white, bgcolor = color.new(color.red, 60))
        table.cell(statusTbl, 0, 5, "Max Drawdown", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 5, str.tostring(maxDrawdownPct, "#.##") + "%", text_color = color.white, bgcolor = color.new(color.orange, 60))
        table.cell(statusTbl, 0, 6, "4H Trend",     bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 6, trendBullish ? "Bull" : trendBearish ? "Bear" : "Flat", bgcolor = trendBullish ? color.green : trendBearish ? color.red : color.gray, text_color = color.white)
        table.cell(statusTbl, 0, 7, "1H Momentum",  bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 7, bullishBodyShift ? "Bull Shift" : bearishBodyShift ? "Bear Shift" : "None", text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 8, "Gann Zone",     bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 8, longSetupActive ? "Long Active" : shortSetupActive ? "Short Active" : "Inactive", text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 9, "Stop Hunt",     bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 9, stopHuntLongActive ? "Long Sweep" : stopHuntShortActive ? "Short Sweep" : "None", text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 10, "1m/5m FVG",     bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 10, longFVGFound ? "Long Confluent" : shortFVGFound ? "Short Confluent" : "None", text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 11, "Position",      bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 11, strategy.position_size > 0 ? "Long" : strategy.position_size < 0 ? "Short" : "Flat", text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 12, "Last Signal",   bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 12, longSignal ? "LONG" : shortSignal ? "SHORT" : "-", text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 13, "Total Bars",   bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 13, str.tostring(totalBars), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 14, "Trend Bars",   bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 14, str.tostring(trendBars), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 15, "Momentum Events", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 15, str.tostring(momentumEvents), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 16, "Zone Touch Bars", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 16, str.tostring(zoneTouchBars), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 17, "Stop Hunt Events", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 17, str.tostring(stopHuntEvents), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 18, "FVG Confluences", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 18, str.tostring(fvgConfluences), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 19, "FVG: Dir Match", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 19, str.tostring(fvgDirMatches), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 20, "FVG: Gann Hit", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 20, str.tostring(fvgGannHits), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 21, "FVG: HTF Hit", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 21, str.tostring(fvgHtfHits), text_color = color.white, bgcolor = color.new(color.black, 0))
        table.cell(statusTbl, 0, 22, "FVG: Touch Hit", bgcolor = color.gray, text_color = color.white)
        table.cell(statusTbl, 1, 22, str.tostring(fvgTouchHits), text_color = color.white, bgcolor = color.new(color.black, 0))
