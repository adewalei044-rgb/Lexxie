//@version=6
strategy("1H Retracement + FVG + Breakout Retest Strategy",
     shorttitle = "1H-Retrace-FVG-Retest",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10,
     calc_on_every_tick = true,
     process_orders_on_close = true)

// =============================================================================
// Run this script on a 1-minute chart. The 1H trend/zone is pulled via
// request.security(), so the logic is correct regardless of the chart's own
// timeframe, but the 1m entry trigger assumes a 1m chart.
//
// MODEL:
// 1) 1H trend: the most recently closed 1H candle's body is fully above (bull)
//    or below (bear) the prior 1H candle's body.
// 2) Retracement zone: a shallow pullback zone sized at a % (default 20%) of
//    that 1H candle's range, taken from the breakout edge — e.g. for a bull
//    candle, the zone is the top 20% of its range (a shallow dip back into
//    the candle, not a deep retracement).
// 3) 1m FVG: a 3-candle Fair Value Gap on the 1m chart must overlap that zone.
// 4) 1m breakout + retest: price must break a recent 1m swing high/low in the
//    trend direction, then retest (pull back to) that broken level and hold,
//    confirming the breakout before entry.
//
// WEBHOOK NOTE: Pine Script cannot call a URL directly — TradingView posts
// the alert_message JSON below to whatever "Webhook URL" you paste into the
// alert dialog when you create an alert from this strategy.
// =============================================================================

// ----------------------------------------------------------------------------
// INPUTS
// ----------------------------------------------------------------------------
grpRules            = "Step 0 - Enable / Disable Rules (for testing)"
enableTrend         = input.bool(true, "1H Trend Filter",            tooltip = "Off = ignore the 1H trend direction; long and short both become available regardless of trend.", group = grpRules)
enableZone          = input.bool(true, "1H Retracement Zone",        tooltip = "Off = ignore the retracement-zone requirement.", group = grpRules)
enableFVG           = input.bool(true, "1m FVG in Zone",             tooltip = "Off = ignore the requirement for a 1m Fair Value Gap inside the retracement zone.", group = grpRules)
enableBreakoutRetest= input.bool(true, "1m Breakout + Retest",       tooltip = "Off = ignore the breakout/retest requirement.", group = grpRules)

grpTrend  = "Step 1 - Trend Filter (1H)"
trendTF   = input.timeframe("60", "1H Trend Timeframe", tooltip = "Timeframe used for the trend candle. Default 60 = 1 hour.", group = grpTrend)

grpZone   = "Step 2 - Retracement Zone (1H)"
retracePct = input.float(0.20, "Retracement Zone Size (0-1 of 1H candle range)", minval = 0.01, maxval = 1.0, step = 0.01, tooltip = "How deep the pullback zone is, as a fraction of the most recent 1H candle's range, measured from the breakout edge. 0.20 = shallow 20% dip back into the candle. Raise toward 1.0 to accept deeper retracements (more setups, less strict).", group = grpZone)

grpFVG    = "Step 3 - Fair Value Gap (1m)"
ltfFVGTF  = input.timeframe("1", "FVG Timeframe", tooltip = "Timeframe used for FVG detection. Default 1 = 1 minute.", group = grpFVG)
fvgMaxAge = input.int(100, "Max FVG Age (bars)", tooltip = "How many bars an FVG stays usable after it forms. Raising this keeps gaps active longer.", group = grpFVG)
fvgMaxActive = input.int(40, "Max Tracked FVGs", tooltip = "How many recent gaps are remembered at once.", group = grpFVG)
fvgZoneBufferPct = input.float(1.0, "FVG-vs-Zone Overlap Tolerance (x zone size)", minval = 0.0, step = 0.25, tooltip = "Requiring the 1m FVG to literally overlap the retracement zone is strict. This pads the zone by this multiple of its own size before checking overlap, so near-misses still count. 0 = exact overlap only.", group = grpFVG)

grpBreak  = "Step 4 - Breakout + Retest (1m)"
breakoutLookback  = input.int(10, "Breakout Swing Lookback (bars)", tooltip = "How many bars back to look for the swing high/low that price must break. Raising this finds breakouts less often but on bigger moves.", group = grpBreak)
retestValidBars   = input.int(15, "Retest Stays Valid For (bars)", tooltip = "How many bars after a breakout the retest is still accepted.", group = grpBreak)
retestToleranceTicks = input.float(5, "Retest Tolerance (ticks beyond broken level)", tooltip = "How far price may dip past the broken level on the retest and still count as holding.", group = grpBreak)

grpRisk   = "Step 5 - Risk Management (SL / TP)"
rrMultiple    = input.float(2.0, "Reward : Risk Multiple", step = 0.1, tooltip = "Take-profit distance as a multiple of the stop-loss distance.", group = grpRisk)
slBufferTicks = input.float(2, "Extra SL Buffer (ticks beyond retest level)", tooltip = "Extra cushion added beyond the retested level when placing the stop-loss.", group = grpRisk)
useConfirmedBar = input.bool(true, "Only Trigger on Confirmed (Closed) Bar", tooltip = "On = waits for the bar to fully close before triggering (safer, no repaint).", group = grpRisk)

grpWebhook    = "Step 6 - Webhook Alert Payload"
webhookSymbol = input.string("", "Symbol Override for JSON (blank = chart ticker)", group = grpWebhook)
qtyForAlert   = input.float(1, "Quantity field to send in JSON", group = grpWebhook)

grpVis        = "Step 7 - Display / Visuals"
showZoneLines  = input.bool(true, "Show Retracement Zone Lines", group = grpVis)
showTable      = input.bool(true, "Show Status Table", group = grpVis)
showTradeBoxes = input.bool(true, "Show Entry/TP/SL Boxes", group = grpVis)
boxExtendBars  = input.int(30, "Box Min Width (bars)", group = grpVis)

grpLimits = "Step 8 - Session & Risk Limits (Optional, all default Off)"
enableSessionFilter = input.bool(false, "Session Time Filter", tooltip = "Off = trade any time of day. On = only allow entries inside any session window enabled below.", group = grpLimits)
sessionTimezone     = input.string("UTC", "Session Timezone (e.g. UTC, America/New_York)", group = grpLimits)
enableAsiaSession   = input.bool(false, "Asia Session", group = grpLimits)
asiaSessionInput    = input.session("0000-0900", "Asia Session Hours", group = grpLimits)
enableLondonSession = input.bool(false, "London Session", group = grpLimits)
londonSessionInput  = input.session("0800-1700", "London Session Hours", group = grpLimits)
enableNYSession     = input.bool(false, "New York Session", group = grpLimits)
nySessionInput      = input.session("1300-2200", "New York Session Hours", group = grpLimits)
enableDailyLimit     = input.bool(false, "Daily Trade / Loss Limit", tooltip = "Off = no daily cap. On = blocks new entries once max trades/day or max daily loss % (from equity at day start) is hit.", group = grpLimits)
maxDailyTrades       = input.int(10, "Max Trades Per Day", minval = 1, group = grpLimits)
maxDailyLossPct      = input.float(2.0, "Max Daily Loss % (of day-start equity)", minval = 0.1, group = grpLimits)
enableDrawdownLimit  = input.bool(false, "Max Drawdown Limit", tooltip = "Off = no drawdown cap. On = blocks new entries once drawdown from peak equity exceeds this %.", group = grpLimits)
maxDrawdownPct       = input.float(20.0, "Max Drawdown % - Stop New Entries", minval = 1.0, group = grpLimits)

// ----------------------------------------------------------------------------
// 1) 1H TREND FILTER
// ----------------------------------------------------------------------------
h1Open  = request.security(syminfo.tickerid, trendTF, open[1],  lookahead = barmerge.lookahead_off)
h1High  = request.security(syminfo.tickerid, trendTF, high[1],  lookahead = barmerge.lookahead_off)
h1Low   = request.security(syminfo.tickerid, trendTF, low[1],   lookahead = barmerge.lookahead_off)
h1Close = request.security(syminfo.tickerid, trendTF, close[1], lookahead = barmerge.lookahead_off)
h2Open  = request.security(syminfo.tickerid, trendTF, open[2],  lookahead = barmerge.lookahead_off)
h2Close = request.security(syminfo.tickerid, trendTF, close[2], lookahead = barmerge.lookahead_off)

h1BodyHigh = math.max(h1Open, h1Close)
h1BodyLow  = math.min(h1Open, h1Close)
h2BodyHigh = math.max(h2Open, h2Close)
h2BodyLow  = math.min(h2Open, h2Close)

trendBullish = h1BodyLow  > h2BodyHigh
trendBearish = h1BodyHigh < h2BodyLow

// ----------------------------------------------------------------------------
// 2) RETRACEMENT ZONE (shallow pullback into the most recent 1H candle)
// ----------------------------------------------------------------------------
h1Range = h1High - h1Low

longZoneHigh  = h1High
longZoneLow   = h1High - retracePct * h1Range
shortZoneLow  = h1Low
shortZoneHigh = h1Low + retracePct * h1Range

priceInLongZone  = low  <= longZoneHigh  and high >= longZoneLow
priceInShortZone = high >= shortZoneLow  and low  <= shortZoneHigh

// ----------------------------------------------------------------------------
// 3) FVG TRACKING (1m)
// ----------------------------------------------------------------------------
trackFVG(tf, maxCount, topArr, botArr, bullArr, barArr) =>
    h1 = request.security(syminfo.tickerid, tf, high[1], lookahead = barmerge.lookahead_off)
    h3 = request.security(syminfo.tickerid, tf, high[3], lookahead = barmerge.lookahead_off)
    l1 = request.security(syminfo.tickerid, tf, low[1],  lookahead = barmerge.lookahead_off)
    l3 = request.security(syminfo.tickerid, tf, low[3],  lookahead = barmerge.lookahead_off)
    t1 = request.security(syminfo.tickerid, tf, time[1], lookahead = barmerge.lookahead_off)

    var int lastClosedTime = na
    isNewClose = t1 != lastClosedTime

    bull = l1 > h3
    bear = h1 < l3

    if isNewClose
        lastClosedTime := t1
        if bull
            array.push(topArr, l1)
            array.push(botArr, h3)
            array.push(bullArr, true)
            array.push(barArr, bar_index)
        if bear
            array.push(topArr, l3)
            array.push(botArr, h1)
            array.push(bullArr, false)
            array.push(barArr, bar_index)
        while array.size(topArr) > maxCount
            array.shift(topArr)
            array.shift(botArr)
            array.shift(bullArr)
            array.shift(barArr)

var float[] ltfTop  = array.new<float>()
var float[] ltfBot  = array.new<float>()
var bool[]  ltfBull = array.new<bool>()
var int[]   ltfBar  = array.new<int>()

trackFVG(ltfFVGTF, fvgMaxActive, ltfTop, ltfBot, ltfBull, ltfBar)

findFVGInZone(isBull, zoneLow, zoneHigh) =>
    found    = false
    foundTop = float(na)
    foundBot = float(na)
    dirMatch = false
    zoneHit  = false

    n = array.size(ltfTop)
    if n > 0
        for i = 0 to n - 1
            if array.get(ltfBull, i) == isBull and (bar_index - array.get(ltfBar, i)) <= fvgMaxAge
                dirMatch := true
                t1 = array.get(ltfTop, i)
                b1 = array.get(ltfBot, i)
                pad = (zoneHigh - zoneLow) * fvgZoneBufferPct
                overlap = math.max(b1, zoneLow - pad) <= math.min(t1, zoneHigh + pad)
                if overlap
                    zoneHit := true
                    found    := true
                    foundTop := t1
                    foundBot := b1
    [found, foundTop, foundBot, dirMatch, zoneHit]

[longFVGFound,  longFvgTop,  longFvgBot,  longFvgDirMatch,  longFvgZoneHit]  = findFVGInZone(true,  longZoneLow,  longZoneHigh)
[shortFVGFound, shortFvgTop, shortFvgBot, shortFvgDirMatch, shortFvgZoneHit] = findFVGInZone(false, shortZoneLow, shortZoneHigh)

// ----------------------------------------------------------------------------
// 4) 1m BREAKOUT + RETEST
// ----------------------------------------------------------------------------
recentSwingHigh = ta.highest(high, breakoutLookback)[1]
recentSwingLow  = ta.lowest(low,  breakoutLookback)[1]

breakoutUp   = close > recentSwingHigh
breakoutDown = close < recentSwingLow

var float lastBreakoutHighLevel = na
var int   lastBreakoutHighBar   = na
var float lastBreakoutLowLevel  = na
var int   lastBreakoutLowBar    = na

if breakoutUp
    lastBreakoutHighLevel := recentSwingHigh
    lastBreakoutHighBar   := bar_index
if breakoutDown
    lastBreakoutLowLevel := recentSwingLow
    lastBreakoutLowBar   := bar_index

retestLongActive  = not na(lastBreakoutHighBar) and (bar_index - lastBreakoutHighBar) <= retestValidBars
retestShortActive = not na(lastBreakoutLowBar)  and (bar_index - lastBreakoutLowBar)  <= retestValidBars

retestLongTouch  = retestLongActive  and low  <= lastBreakoutHighLevel + retestToleranceTicks * syminfo.mintick and close > lastBreakoutHighLevel
retestShortTouch = retestShortActive and high >= lastBreakoutLowLevel  - retestToleranceTicks * syminfo.mintick and close < lastBreakoutLowLevel

// ----------------------------------------------------------------------------
// 4B) SESSION & RISK LIMITS (Step 8 inputs — all default Off, so existing
//     behavior is unaffected unless one is switched on)
// ----------------------------------------------------------------------------
inAsiaSession     = enableAsiaSession   and not na(time(timeframe.period, asiaSessionInput,   sessionTimezone))
inLondonSession   = enableLondonSession and not na(time(timeframe.period, londonSessionInput, sessionTimezone))
inNYSession       = enableNYSession     and not na(time(timeframe.period, nySessionInput,     sessionTimezone))
anySessionEnabled = enableAsiaSession or enableLondonSession or enableNYSession
inSession = not enableSessionFilter or not anySessionEnabled or inAsiaSession or inLondonSession or inNYSession

newDay = ta.change(dayofmonth(time)) != 0
var float dayStartEquity = strategy.initial_capital
var int   dayTradeCount  = 0
if newDay
    dayStartEquity := strategy.equity
    dayTradeCount  := 0

dailyLossPct = dayStartEquity > 0 ? (dayStartEquity - strategy.equity) / dayStartEquity * 100.0 : 0.0
dailyLimitOk = not enableDailyLimit or (dayTradeCount < maxDailyTrades and dailyLossPct < maxDailyLossPct)

var float peakEquity = strategy.initial_capital
peakEquity := math.max(peakEquity, strategy.equity)
drawdownPct = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100.0 : 0.0
drawdownOk = not enableDrawdownLimit or drawdownPct < maxDrawdownPct

riskGateOk = inSession and dailyLimitOk and drawdownOk

// ----------------------------------------------------------------------------
// 5) ENTRY SIGNAL
// ----------------------------------------------------------------------------
barGate = useConfirmedBar ? barstate.isconfirmed : true

longSignal  = (not enableTrend or trendBullish) and (not enableZone or priceInLongZone) and (not enableFVG or longFVGFound) and (not enableBreakoutRetest or retestLongTouch)  and barGate and riskGateOk and strategy.position_size <= 0
shortSignal = (not enableTrend or trendBearish) and (not enableZone or priceInShortZone) and (not enableFVG or shortFVGFound) and (not enableBreakoutRetest or retestShortTouch) and barGate and riskGateOk and strategy.position_size >= 0

// ----------------------------------------------------------------------------
// 6) RISK MANAGEMENT + WEBHOOK ALERT PAYLOADS
// ----------------------------------------------------------------------------
webhookSymbolStr = webhookSymbol == "" ? syminfo.ticker : webhookSymbol

var box   profitBox  = na
var box   riskBox    = na
var label entryLabel = na

drawTradeVisuals(isLong, entryPrice, sl, tp, useSimpleLabel) =>
    box.delete(profitBox)
    box.delete(riskBox)
    label.delete(entryLabel)
    rightBar     = bar_index + boxExtendBars
    profitTop    = isLong ? tp : entryPrice
    profitBottom = isLong ? entryPrice : tp
    riskTop      = isLong ? entryPrice : sl
    riskBottom   = isLong ? sl : entryPrice
    newProfitBox = box.new(bar_index, profitTop, rightBar, profitBottom, border_color = color.green, bgcolor = color.new(color.green, 85))
    newRiskBox   = box.new(bar_index, riskTop, rightBar, riskBottom, border_color = color.red, bgcolor = color.new(color.red, 85))
    newLabel     = useSimpleLabel
         ? label.new(bar_index, isLong ? entryPrice - (tp - entryPrice) * 0.1 : entryPrice + (entryPrice - tp) * 0.1, isLong ? "BUY" : "SELL", style = isLong ? label.style_label_up : label.style_label_down, color = isLong ? color.green : color.red, textcolor = color.white, size = size.small)
         : label.new(bar_index, entryPrice,
              (isLong ? "BUY" : "SELL") + "\nEntry " + str.tostring(entryPrice, format.mintick) + "\nTP " + str.tostring(tp, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "\nR:R 1:" + str.tostring(rrMultiple, "#.#"),
              style = isLong ? label.style_label_up : label.style_label_down,
              color = isLong ? color.green : color.red, textcolor = color.white, size = size.small)
    [newProfitBox, newRiskBox, newLabel]

if longSignal
    // Fall back to the recent swing low if no breakout level is recorded
    // (e.g. Breakout/Retest rule toggled off), so SL never computes from na.
    slRefLong = na(lastBreakoutHighLevel) ? recentSwingLow : lastBreakoutHighLevel
    slPrice = slRefLong - slBufferTicks * syminfo.mintick
    risk    = close - slPrice
    tpPrice = close + risk * rrMultiple
    longMsg = "{\"action\":\"buy\",\"symbol\":\"" + webhookSymbolStr + "\",\"side\":\"long\",\"price\":" + str.tostring(close) + ",\"sl\":" + str.tostring(slPrice) + ",\"tp\":" + str.tostring(tpPrice) + ",\"qty\":" + str.tostring(qtyForAlert) + ",\"strategy\":\"1H-Retrace-FVG-Retest\",\"time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ") + "\"}"
    exitMsg = "{\"action\":\"close\",\"symbol\":\"" + webhookSymbolStr + "\",\"side\":\"long\",\"strategy\":\"1H-Retrace-FVG-Retest\"}"
    strategy.entry("Long", strategy.long, alert_message = longMsg)
    strategy.exit("Long Exit", from_entry = "Long", stop = slPrice, limit = tpPrice, alert_message = exitMsg)
    dayTradeCount := dayTradeCount + 1
    if showTradeBoxes
        [pb, rb, el] = drawTradeVisuals(true, close, slPrice, tpPrice, true)
        profitBox  := pb
        riskBox    := rb
        entryLabel := el
    else
        label.new(bar_index, low, "BUY", style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)

if shortSignal
    slRefShort = na(lastBreakoutLowLevel) ? recentSwingHigh : lastBreakoutLowLevel
    slPrice = slRefShort + slBufferTicks * syminfo.mintick
    risk    = slPrice - close
    tpPrice = close - risk * rrMultiple
    shortMsg = "{\"action\":\"sell\",\"symbol\":\"" + webhookSymbolStr + "\",\"side\":\"short\",\"price\":" + str.tostring(close) + ",\"sl\":" + str.tostring(slPrice) + ",\"tp\":" + str.tostring(tpPrice) + ",\"qty\":" + str.tostring(qtyForAlert) + ",\"strategy\":\"1H-Retrace-FVG-Retest\",\"time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ") + "\"}"
    exitMsg = "{\"action\":\"close\",\"symbol\":\"" + webhookSymbolStr + "\",\"side\":\"short\",\"strategy\":\"1H-Retrace-FVG-Retest\"}"
    strategy.entry("Short", strategy.short, alert_message = shortMsg)
    strategy.exit("Short Exit", from_entry = "Short", stop = slPrice, limit = tpPrice, alert_message = exitMsg)
    dayTradeCount := dayTradeCount + 1
    if showTradeBoxes
        [pb, rb, el] = drawTradeVisuals(false, close, slPrice, tpPrice, true)
        profitBox  := pb
        riskBox    := rb
        entryLabel := el
    else
        label.new(bar_index, high, "SELL", style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)

if showTradeBoxes and strategy.position_size != 0 and not na(profitBox)
    box.set_right(profitBox, math.max(bar_index, box.get_right(profitBox)))
    box.set_right(riskBox, math.max(bar_index, box.get_right(riskBox)))

// ----------------------------------------------------------------------------
// 7) VISUALS + DIAGNOSTICS
// ----------------------------------------------------------------------------
plot(showZoneLines and trendBullish ? longZoneLow   : na, "Long Zone Low",   color.new(color.lime, 0), style = plot.style_linebr)
plot(showZoneLines and trendBullish ? longZoneHigh  : na, "Long Zone High",  color.new(color.lime, 0), style = plot.style_linebr)
plot(showZoneLines and trendBearish ? shortZoneLow  : na, "Short Zone Low",  color.new(color.red, 0),  style = plot.style_linebr)
plot(showZoneLines and trendBearish ? shortZoneHigh : na, "Short Zone High", color.new(color.red, 0),  style = plot.style_linebr)

plotshape(longSignal  ? low  : na, "Buy Entry Logo",  style = shape.labelup,   location = location.belowbar, color = color.lime, size = size.small, text = "BUY",  textcolor = color.black)
plotshape(shortSignal ? high : na, "Sell Entry Logo", style = shape.labeldown, location = location.abovebar, color = color.red,  size = size.small, text = "SELL", textcolor = color.white)

winTrades   = strategy.wintrades
lossTrades  = strategy.losstrades
totalClosed = strategy.closedtrades
winPct = totalClosed > 0 ? (winTrades / totalClosed) * 100.0 : 0.0

currentDateStr = str.format_time(time, "yyyy-MM-dd")
var string lastDateStr     = na
var int    dailyWin        = 0
var int    dailyLoss       = 0
var int    prevClosedCount = 0
if na(lastDateStr) or currentDateStr != lastDateStr
    dailyWin    := 0
    dailyLoss   := 0
    lastDateStr := currentDateStr

if totalClosed > prevClosedCount
    lastTradeProfit = strategy.closedtrades.profit(totalClosed - 1)
    if lastTradeProfit > 0
        dailyWin := dailyWin + 1
    else
        dailyLoss := dailyLoss + 1
    prevClosedCount := totalClosed

titleBg    = color.rgb(20, 22, 38)
titleText  = color.rgb(255, 205, 60)
labelBg    = color.rgb(32, 35, 52)
labelText  = color.rgb(190, 198, 220)
winRateBg  = color.rgb(10, 95, 145)
winBg      = color.rgb(15, 120, 80)
lossBg     = color.rgb(160, 35, 45)
dailyWinBg = color.rgb(25, 150, 100)
dailyLossBg= color.rgb(190, 60, 60)
drawdownBg = color.rgb(195, 120, 15)

if showTable
    var table statusTbl = table.new(position.top_right, 2, 7, border_width = 2, border_color = color.rgb(255, 205, 60))
    if barstate.islast
        table.cell(statusTbl, 0, 0, "STRATEGY STATS", bgcolor = titleBg, text_color = titleText, text_size = size.normal)
        table.cell(statusTbl, 1, 0, "", bgcolor = titleBg)
        table.cell(statusTbl, 0, 1, "Win Rate", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 1, str.tostring(winPct, "#.##") + "%", text_color = color.white, bgcolor = winRateBg)
        table.cell(statusTbl, 0, 2, "Win", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 2, str.tostring(winTrades), text_color = color.white, bgcolor = winBg)
        table.cell(statusTbl, 0, 3, "Loss", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 3, str.tostring(lossTrades), text_color = color.white, bgcolor = lossBg)
        table.cell(statusTbl, 0, 4, "Daily Win", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 4, str.tostring(dailyWin), text_color = color.white, bgcolor = dailyWinBg)
        table.cell(statusTbl, 0, 5, "Daily Loss", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 5, str.tostring(dailyLoss), text_color = color.white, bgcolor = dailyLossBg)
        table.cell(statusTbl, 0, 6, "Drawdown", bgcolor = labelBg, text_color = labelText)
        table.cell(statusTbl, 1, 6, str.tostring(drawdownPct, "#.##") + "%", text_color = color.white, bgcolor = drawdownBg)
