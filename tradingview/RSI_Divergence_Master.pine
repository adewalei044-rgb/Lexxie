//@version=6
indicator("RSI Divergence Master - Regular, Hidden & Key Level", overlay=true, max_lines_count=200, max_labels_count=200, max_bars_back=500)

// =====================================================================================
// Three-strategy RSI divergence framework:
//   1) Regular divergence  -> reversal, confirmed by a swing trend line break
//   2) Hidden divergence    -> trend continuation, filtered by 200 EMA, triggered by Stochastic cross
//   3) Key level divergence -> divergence + rejection candle + trend line break at a major S/R level
// Signal-only indicator: no strategy() backtest output, no log/print debugging, no text labels.
// =====================================================================================

// ---------------------------- Inputs ----------------------------
grpRSI = "RSI"
rsiLen  = input.int(14, "RSI Length", group = grpRSI)
rsiSrc  = input.source(close, "RSI Source", group = grpRSI)

grpPivot = "Divergence Pivots"
pvtLeft  = input.int(5, "Pivot Left Bars", minval = 1, group = grpPivot)
pvtRight = input.int(5, "Pivot Right Bars", minval = 1, group = grpPivot)
maxBars  = input.int(60, "Max Bars Between Pivots", minval = 5, group = grpPivot)

grpTrend = "Hidden Divergence Trend Filter"
emaLen   = input.int(200, "EMA Length", group = grpTrend)

grpStoch = "Stochastic Confirmation"
stochK       = input.int(14, "%K Length", group = grpStoch)
stochSmoothK = input.int(3, "%K Smoothing", group = grpStoch)
stochD       = input.int(3, "%D Smoothing", group = grpStoch)
stochMaxWait = input.int(10, "Max Bars to Wait for Stoch Cross", group = grpStoch)

grpLevel = "Key Level Confluence"
lvlLeft     = input.int(15, "Key Level Pivot Left", group = grpLevel)
lvlRight    = input.int(15, "Key Level Pivot Right", group = grpLevel)
lvlLookback = input.int(300, "Key Level Memory (bars)", group = grpLevel)
lvlTolPct   = input.float(0.25, "Proximity to Level (%)", minval = 0.01, group = grpLevel)
wickRatio   = input.float(1.5, "Min Wick/Body Ratio for Rejection Candle", minval = 0.5, group = grpLevel)

grpShow = "Display"
showRegular    = input.bool(true, "Show Regular Divergence Signals", group = grpShow)
showHidden     = input.bool(true, "Show Hidden Divergence Signals", group = grpShow)
showKeyLevel   = input.bool(true, "Show Key Level Reversal Signals", group = grpShow)
showTrendLines = input.bool(true, "Show Divergence Trend Lines", group = grpShow)
showKeyLevels  = input.bool(true, "Show Key S/R Levels", group = grpShow)

// ---------------------------- Core series ----------------------------
rsi   = ta.rsi(rsiSrc, rsiLen)
ema200 = ta.ema(close, emaLen)
stochRaw = ta.sma(ta.stoch(close, high, low, stochK), stochSmoothK)
stochD_  = ta.sma(stochRaw, stochD)

isUptrend   = close > ema200
isDowntrend = close < ema200

// ---------------------------- Pivot detection (price-anchored) ----------------------------
phPrice = ta.pivothigh(high, pvtLeft, pvtRight)
plPrice = ta.pivotlow(low, pvtLeft, pvtRight)

var float lastPH    = na
var int   lastPHBar = na
var float lastPHRsi = na

var float lastPL    = na
var int   lastPLBar = na
var float lastPLRsi = na

bullRegularAt  = false
bearRegularAt  = false
bullHiddenAt   = false
bearHiddenAt   = false

var float bullLineSlope = na
var float bullLineAnchorPrice = na
var int   bullLineAnchorBar = na
var bool  bullLineActive = false

var float bearLineSlope = na
var float bearLineAnchorPrice = na
var int   bearLineAnchorBar = na
var bool  bearLineActive = false

var line bullTrendLine = na
var line bearTrendLine = na

if not na(plPrice)
    curBar = bar_index - pvtRight
    curPrice = plPrice
    curRsi = rsi[pvtRight]
    if not na(lastPL) and (curBar - lastPLBar) <= maxBars
        bullRegularAt := curPrice < lastPL and curRsi > lastPLRsi
        bullHiddenAt  := curPrice > lastPL and curRsi < lastPLRsi
        if bullRegularAt
            bullLineSlope := (curPrice - lastPL) / (curBar - lastPLBar)
            bullLineAnchorPrice := curPrice
            bullLineAnchorBar := curBar
            bullLineActive := true
            if showTrendLines
                bullTrendLine := line.new(lastPLBar, lastPL, curBar, curPrice, color = color.new(color.lime, 0), width = 1, extend = extend.right)
    lastPL := curPrice
    lastPLBar := curBar
    lastPLRsi := curRsi

if not na(phPrice)
    curBar = bar_index - pvtRight
    curPrice = phPrice
    curRsi = rsi[pvtRight]
    if not na(lastPH) and (curBar - lastPHBar) <= maxBars
        bearRegularAt := curPrice > lastPH and curRsi < lastPHRsi
        bearHiddenAt  := curPrice < lastPH and curRsi > lastPHRsi
        if bearRegularAt
            bearLineSlope := (curPrice - lastPH) / (curBar - lastPHBar)
            bearLineAnchorPrice := curPrice
            bearLineAnchorBar := curBar
            bearLineActive := true
            if showTrendLines
                bearTrendLine := line.new(lastPHBar, lastPH, curBar, curPrice, color = color.new(color.red, 0), width = 1, extend = extend.right)
    lastPH := curPrice
    lastPHBar := curBar
    lastPHRsi := curRsi

// ---------------------------- Regular divergence -> trend line break confirmation ----------------------------
bullLineValue = bullLineActive ? bullLineAnchorPrice + bullLineSlope * (bar_index - bullLineAnchorBar) : na
bearLineValue = bearLineActive ? bearLineAnchorPrice + bearLineSlope * (bar_index - bearLineAnchorBar) : na

bullBreakout = bullLineActive and ta.crossunder(close, bullLineValue)
bearBreakout = bearLineActive and ta.crossover(close, bearLineValue)

if bullBreakout
    bullLineActive := false
if bearBreakout
    bearLineActive := false

regularBullSignal = showRegular and bullBreakout
regularBearSignal = showRegular and bearBreakout

// ---------------------------- Hidden divergence -> EMA filter + Stochastic cross confirmation ----------------------------
var int bullHiddenPendingBar = na
var int bearHiddenPendingBar = na

if bullHiddenAt and isUptrend
    bullHiddenPendingBar := bar_index
if bearHiddenAt and isDowntrend
    bearHiddenPendingBar := bar_index

stochCrossUp   = ta.crossover(stochRaw, stochD_)
stochCrossDown = ta.crossunder(stochRaw, stochD_)

hiddenBullSignal = showHidden and not na(bullHiddenPendingBar) and (bar_index - bullHiddenPendingBar) <= stochMaxWait and stochCrossUp and isUptrend
hiddenBearSignal = showHidden and not na(bearHiddenPendingBar) and (bar_index - bearHiddenPendingBar) <= stochMaxWait and stochCrossDown and isDowntrend

if hiddenBullSignal
    bullHiddenPendingBar := na
if hiddenBearSignal
    bearHiddenPendingBar := na

// ---------------------------- Key level detection ----------------------------
lvlPH = ta.pivothigh(high, lvlLeft, lvlRight)
lvlPL = ta.pivotlow(low, lvlLeft, lvlRight)

var array<float> resLevels = array.new_float()
var array<int>   resBars   = array.new_int()
var array<float> supLevels = array.new_float()
var array<int>   supBars   = array.new_int()

if not na(lvlPH)
    array.push(resLevels, lvlPH)
    array.push(resBars, bar_index - lvlRight)
if not na(lvlPL)
    array.push(supLevels, lvlPL)
    array.push(supBars, bar_index - lvlRight)

if array.size(resBars) > 0
    for i = array.size(resBars) - 1 to 0
        if bar_index - array.get(resBars, i) > lvlLookback
            array.remove(resBars, i)
            array.remove(resLevels, i)
if array.size(supBars) > 0
    for i = array.size(supBars) - 1 to 0
        if bar_index - array.get(supBars, i) > lvlLookback
            array.remove(supBars, i)
            array.remove(supLevels, i)

nearResistance = false
nearSupport = false
if array.size(resLevels) > 0
    for i = 0 to array.size(resLevels) - 1
        lvl = array.get(resLevels, i)
        if math.abs(close - lvl) / lvl * 100 <= lvlTolPct
            nearResistance := true
if array.size(supLevels) > 0
    for i = 0 to array.size(supLevels) - 1
        lvl = array.get(supLevels, i)
        if math.abs(close - lvl) / lvl * 100 <= lvlTolPct
            nearSupport := true

bodyRange  = math.max(math.abs(close - open), syminfo.mintick)
upperWick  = high - math.max(close, open)
lowerWick  = math.min(close, open) - low

bullishRejection = nearSupport and (lowerWick >= wickRatio * bodyRange)
bearishRejection = nearResistance and (upperWick >= wickRatio * bodyRange)

keyLevelBullSignal = showKeyLevel and bullishRejection and bullBreakout
keyLevelBearSignal = showKeyLevel and bearishRejection and bearBreakout

// ---------------------------- Plots ----------------------------
plotshape(regularBullSignal, title = "Regular Bullish Divergence", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.small)
plotshape(regularBearSignal, title = "Regular Bearish Divergence", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small)

plotshape(hiddenBullSignal, title = "Hidden Bullish Divergence", style = shape.circle, location = location.belowbar, color = color.new(color.aqua, 0), size = size.tiny)
plotshape(hiddenBearSignal, title = "Hidden Bearish Divergence", style = shape.circle, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)

plotshape(keyLevelBullSignal, title = "Key Level Bullish Reversal", style = shape.diamond, location = location.belowbar, color = color.new(color.yellow, 0), size = size.normal)
plotshape(keyLevelBearSignal, title = "Key Level Bearish Reversal", style = shape.diamond, location = location.abovebar, color = color.new(color.fuchsia, 0), size = size.normal)

plot(showTrendLines ? ema200 : na, title = "200 EMA", color = color.new(color.blue, 40))

if showKeyLevels and not na(lvlPH)
    line.new(bar_index - lvlRight, lvlPH, bar_index, lvlPH, color = color.new(color.red, 60), style = line.style_dashed, extend = extend.right)
if showKeyLevels and not na(lvlPL)
    line.new(bar_index - lvlRight, lvlPL, bar_index, lvlPL, color = color.new(color.lime, 60), style = line.style_dashed, extend = extend.right)

// ---------------------------- Alerts ----------------------------
alertcondition(regularBullSignal, title = "Regular Bullish Divergence Break", message = "Regular bullish RSI divergence confirmed by trend line break")
alertcondition(regularBearSignal, title = "Regular Bearish Divergence Break", message = "Regular bearish RSI divergence confirmed by trend line break")
alertcondition(hiddenBullSignal, title = "Hidden Bullish Divergence Confirmed", message = "Hidden bullish RSI divergence confirmed by Stochastic cross above 200 EMA")
alertcondition(hiddenBearSignal, title = "Hidden Bearish Divergence Confirmed", message = "Hidden bearish RSI divergence confirmed by Stochastic cross below 200 EMA")
alertcondition(keyLevelBullSignal, title = "Key Level Bullish Reversal", message = "Bullish rejection + divergence trend line break at key support level")
alertcondition(keyLevelBearSignal, title = "Key Level Bearish Reversal", message = "Bearish rejection + divergence trend line break at key resistance level")
