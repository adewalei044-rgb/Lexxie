//@version=6
strategy("Lexxie Strategy v6", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true, initial_capital=1000)

almaLen     = input.int(9, "ALMA Length", group="Trend / Band")
almaOffset  = input.float(0.85, "ALMA Offset", step=0.05, group="Trend / Band")
almaSigma   = input.float(6, "ALMA Sigma", group="Trend / Band")
biasLen     = input.int(50, "Bias ALMA Length", group="Trend / Band")
atrLen      = input.int(14, "ATR Length", group="Trend / Band")
bandMult    = input.float(1.5, "Entry Band ATR Mult", group="Trend / Band")

slPercent       = input.float(0.5, "Stop Loss %", step=0.1, group="Trade Options")
enableTP1       = input.bool(true, "Enable TP1 (1R)", group="Trade Options")
enableTP2       = input.bool(true, "Enable TP2 (2R)", group="Trade Options")
enableTP3       = input.bool(true, "Enable TP3 (3R)", group="Trade Options")
maxTradesPerDay = input.int(5, "Max Trades Per Day", minval=1, group="Trade Options")
maxDailyLossPct = input.float(2.0, "Max Daily Loss %", minval=0.1, step=0.1, group="Trade Options")
enableBreakeven = input.bool(true, "Move Stop to Breakeven After TP2", group="Trade Options")

showZones   = input.bool(true, "Show Long/Short Zone Boxes", group="Display")
showSignals = input.bool(true, "Show Buy/Sell Markers", group="Display")
showLevels  = input.bool(true, "Show Entry/SL/TP Lines", group="Display")
showTable   = input.bool(true, "Show Stats Table", group="Display")

basis  = ta.alma(close, almaLen, almaOffset, almaSigma)
bias   = ta.alma(close, biasLen, almaOffset, almaSigma)
atrVal = ta.atr(atrLen)

upperBand = basis + atrVal * bandMult
lowerBand = basis - atrVal * bandMult

bullBias = close > bias
bearBias = close < bias

newDay = ta.change(time("D")) != 0

var int dailyTradeCount = 0
var int dailyWins = 0
var int dailyLosses = 0
var int lastClosedCount = 0
var float dayStartEquity = strategy.initial_capital

if newDay
    dailyTradeCount := 0
    dailyWins := 0
    dailyLosses := 0
    dayStartEquity := strategy.equity

dailyLossPct = dayStartEquity > 0 ? math.max(0.0, (dayStartEquity - strategy.equity) / dayStartEquity * 100) : 0.0
dailyLossLimitReached = dailyLossPct >= maxDailyLossPct

tradeLimitReached = dailyTradeCount >= maxTradesPerDay or dailyLossLimitReached

longCondition  = ta.crossunder(close, lowerBand) and bullBias and strategy.position_size <= 0 and not tradeLimitReached
shortCondition = ta.crossover(close, upperBand) and bearBias and strategy.position_size >= 0 and not tradeLimitReached

if longCondition or shortCondition
    dailyTradeCount := dailyTradeCount + 1

bgcolor(showZones ? (bullBias ? color.new(color.green, 92) : color.new(color.red, 92)) : na, title="Bias Zone")

if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

tp1Percent = slPercent * 1
tp2Percent = slPercent * 2
tp3Percent = slPercent * 3

longSL  = strategy.position_avg_price * (1 - slPercent / 100)
longTP1 = strategy.position_avg_price * (1 + tp1Percent / 100)
longTP2 = strategy.position_avg_price * (1 + tp2Percent / 100)
longTP3 = strategy.position_avg_price * (1 + tp3Percent / 100)

shortSL  = strategy.position_avg_price * (1 + slPercent / 100)
shortTP1 = strategy.position_avg_price * (1 - tp1Percent / 100)
shortTP2 = strategy.position_avg_price * (1 - tp2Percent / 100)
shortTP3 = strategy.position_avg_price * (1 - tp3Percent / 100)

isLastTP1   = enableTP1 and not enableTP2 and not enableTP3
isLastTP2   = enableTP2 and not enableTP3
skipTP1Only = enableTP1 and enableTP2 and not enableTP3
fireTP1     = enableTP1 and not skipTP1Only
qtyTP1 = isLastTP1 ? 100 : 33
qtyTP2 = isLastTP2 ? 100 : 50

var bool tp2Hit = false
if strategy.position_size == 0
    tp2Hit := false
else if strategy.position_size > 0 and high >= longTP2
    tp2Hit := true
else if strategy.position_size < 0 and low <= shortTP2
    tp2Hit := true

longTP3Stop  = enableBreakeven and tp2Hit ? strategy.position_avg_price : longSL
shortTP3Stop = enableBreakeven and tp2Hit ? strategy.position_avg_price : shortSL

if strategy.position_size > 0
    if fireTP1
        strategy.exit("Long TP1", from_entry="Long", qty_percent=qtyTP1, limit=longTP1, stop=longSL)
    if enableTP2
        strategy.exit("Long TP2", from_entry="Long", qty_percent=qtyTP2, limit=longTP2, stop=longSL)
    if enableTP3
        strategy.exit("Long TP3", from_entry="Long", qty_percent=100, limit=longTP3, stop=longTP3Stop)

if strategy.position_size < 0
    if fireTP1
        strategy.exit("Short TP1", from_entry="Short", qty_percent=qtyTP1, limit=shortTP1, stop=shortSL)
    if enableTP2
        strategy.exit("Short TP2", from_entry="Short", qty_percent=qtyTP2, limit=shortTP2, stop=shortSL)
    if enableTP3
        strategy.exit("Short TP3", from_entry="Short", qty_percent=100, limit=shortTP3, stop=shortTP3Stop)

var box longBox = na
var box shortBox = na

maxTPPercent = enableTP3 ? tp3Percent : enableTP2 ? tp2Percent : tp1Percent

if showZones and longCondition
    longBox := box.new(left=bar_index, top=close * (1 + maxTPPercent / 100), bottom=close * (1 - slPercent / 100), right=bar_index, bgcolor=color.new(#FFC0CB, 80), border_color=#FFC0CB, border_width=1)

if showZones and shortCondition
    shortBox := box.new(left=bar_index, top=close * (1 + slPercent / 100), bottom=close * (1 - maxTPPercent / 100), right=bar_index, bgcolor=color.new(color.black, 80), border_color=color.new(color.black, 30), border_width=1)

if showZones and strategy.position_size > 0 and not na(longBox)
    box.set_right(longBox, bar_index)

if showZones and strategy.position_size < 0 and not na(shortBox)
    box.set_right(shortBox, bar_index)

var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var label entryLabel = na
var label slLabel = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na

if showLevels and (longCondition or shortCondition)
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    label.delete(entryLabel)
    label.delete(slLabel)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)

if showLevels and longCondition
    epx = close
    slpx  = close * (1 - slPercent / 100)
    tp1px = close * (1 + tp1Percent / 100)
    tp2px = close * (1 + tp2Percent / 100)
    tp3px = close * (1 + tp3Percent / 100)
    entryLine := line.new(bar_index, epx, bar_index, epx, color=color.blue, width=1)
    slLine := line.new(bar_index, slpx, bar_index, slpx, color=color.red, width=1)
    entryLabel := label.new(bar_index, epx, "Entry: " + str.tostring(epx, "#.##"), style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.small)
    slLabel := label.new(bar_index, slpx, "SL: " + str.tostring(slpx, "#.##"), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    if fireTP1
        tp1Line := line.new(bar_index, tp1px, bar_index, tp1px, color=color.green, width=1)
        tp1Label := label.new(bar_index, tp1px, "TP1: " + str.tostring(tp1px, "#.##"), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)
    if enableTP2
        tp2Line := line.new(bar_index, tp2px, bar_index, tp2px, color=color.green, width=1)
        tp2Label := label.new(bar_index, tp2px, "TP2: " + str.tostring(tp2px, "#.##"), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)
    if enableTP3
        tp3Line := line.new(bar_index, tp3px, bar_index, tp3px, color=color.green, width=1)
        tp3Label := label.new(bar_index, tp3px, "TP3: " + str.tostring(tp3px, "#.##"), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)

if showLevels and shortCondition
    epx = close
    slpx  = close * (1 + slPercent / 100)
    tp1px = close * (1 - tp1Percent / 100)
    tp2px = close * (1 - tp2Percent / 100)
    tp3px = close * (1 - tp3Percent / 100)
    entryLine := line.new(bar_index, epx, bar_index, epx, color=color.blue, width=1)
    slLine := line.new(bar_index, slpx, bar_index, slpx, color=color.red, width=1)
    entryLabel := label.new(bar_index, epx, "Entry: " + str.tostring(epx, "#.##"), style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.small)
    slLabel := label.new(bar_index, slpx, "SL: " + str.tostring(slpx, "#.##"), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    if fireTP1
        tp1Line := line.new(bar_index, tp1px, bar_index, tp1px, color=color.green, width=1)
        tp1Label := label.new(bar_index, tp1px, "TP1: " + str.tostring(tp1px, "#.##"), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)
    if enableTP2
        tp2Line := line.new(bar_index, tp2px, bar_index, tp2px, color=color.green, width=1)
        tp2Label := label.new(bar_index, tp2px, "TP2: " + str.tostring(tp2px, "#.##"), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)
    if enableTP3
        tp3Line := line.new(bar_index, tp3px, bar_index, tp3px, color=color.green, width=1)
        tp3Label := label.new(bar_index, tp3px, "TP3: " + str.tostring(tp3px, "#.##"), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)

if showLevels and strategy.position_size != 0
    if not na(entryLine)
        line.set_x2(entryLine, bar_index)
        label.set_x(entryLabel, bar_index)
    if not na(slLine)
        effectiveSL = strategy.position_size > 0 ? longTP3Stop : shortTP3Stop
        line.set_x2(slLine, bar_index)
        line.set_y1(slLine, effectiveSL)
        line.set_y2(slLine, effectiveSL)
        label.set_x(slLabel, bar_index)
        label.set_y(slLabel, effectiveSL)
        label.set_text(slLabel, (enableBreakeven and tp2Hit ? "SL (BE): " : "SL: ") + str.tostring(effectiveSL, "#.##"))
    if not na(tp1Line)
        line.set_x2(tp1Line, bar_index)
        label.set_x(tp1Label, bar_index)
    if not na(tp2Line)
        line.set_x2(tp2Line, bar_index)
        label.set_x(tp2Label, bar_index)
    if not na(tp3Line)
        line.set_x2(tp3Line, bar_index)
        label.set_x(tp3Label, bar_index)

if showSignals and longCondition
    label.new(bar_index, low - atrVal * 0.5, "BUY", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if showSignals and shortCondition
    label.new(bar_index, high + atrVal * 0.5, "SELL", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

var float peakEquity = strategy.initial_capital
peakEquity := math.max(peakEquity, strategy.equity)
currentDDPct = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100 : 0.0
var float maxDDPct = 0.0
maxDDPct := math.max(maxDDPct, currentDDPct)

if strategy.closedtrades > lastClosedCount
    lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastProfit > 0
        dailyWins += 1
    else
        dailyLosses += 1
    lastClosedCount := strategy.closedtrades

totalTrades = strategy.closedtrades
wins = strategy.wintrades
losses = strategy.losstrades
winRate = totalTrades > 0 ? wins / totalTrades * 100 : 0.0

var table statsTable = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)

if showTable and barstate.islast
    table.cell(statsTable, 0, 0, "Win Rate", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statsTable, 1, 0, str.tostring(winRate, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statsTable, 0, 1, "Wins", text_color=color.white)
    table.cell(statsTable, 1, 1, str.tostring(wins), text_color=color.green)
    table.cell(statsTable, 0, 2, "Losses", text_color=color.white)
    table.cell(statsTable, 1, 2, str.tostring(losses), text_color=color.red)
    table.cell(statsTable, 0, 3, "Daily Win", text_color=color.white)
    table.cell(statsTable, 1, 3, str.tostring(dailyWins), text_color=color.green)
    table.cell(statsTable, 0, 4, "Daily Loss", text_color=color.white)
    table.cell(statsTable, 1, 4, str.tostring(dailyLosses), text_color=color.red)
    table.cell(statsTable, 0, 5, "Daily Loss %", text_color=color.white)
    table.cell(statsTable, 1, 5, str.tostring(dailyLossPct, "#.##") + "%", text_color=color.red)
    table.cell(statsTable, 0, 6, "Drawdown", text_color=color.white)
    table.cell(statsTable, 1, 6, str.tostring(maxDDPct, "#.##") + "%", text_color=color.orange)
