//@version=6
strategy("Lexxie Strategy v6", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true, initial_capital=1000)

almaLen     = input.int(9, "ALMA Length", group="Trend / Band")
almaOffset  = input.float(0.85, "ALMA Offset", step=0.05, group="Trend / Band")
almaSigma   = input.float(6, "ALMA Sigma", group="Trend / Band")
biasLen     = input.int(50, "Bias ALMA Length", group="Trend / Band")
atrLen      = input.int(14, "ATR Length", group="Trend / Band")
bandMult    = input.float(1.5, "Entry Band ATR Mult", group="Trend / Band")

slPercent   = input.float(0.5, "Stop Loss %", step=0.1, group="Exits")
tpPercent   = input.float(1.0, "Take Profit % (1:2 RR)", step=0.1, group="Exits")

showZones   = input.bool(true, "Show Long/Short Zone Boxes", group="Display")
showSignals = input.bool(true, "Show Buy/Sell Markers", group="Display")
showLevels  = input.bool(true, "Show Entry/SL/TP Lines", group="Display")
showTable   = input.bool(true, "Show Stats Table", group="Display")

basis  = ta.alma(close, almaLen, almaOffset, almaSigma)
bias   = ta.alma(close, biasLen, almaOffset, almaSigma)
atrVal = ta.atr(atrLen)

upperBand = basis + atrVal * bandMult
lowerBand = basis - atrVal * bandMult

bullBias = close > bias
bearBias = close < bias

longCondition  = ta.crossunder(close, lowerBand) and bullBias and strategy.position_size <= 0
shortCondition = ta.crossover(close, upperBand) and bearBias and strategy.position_size >= 0

if showZones
    bgcolor(bullBias ? color.new(color.green, 92) : color.new(color.red, 92), title="Bias Zone")

if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

longSL = strategy.position_avg_price * (1 - slPercent / 100)
longTP = strategy.position_avg_price * (1 + tpPercent / 100)

shortSL = strategy.position_avg_price * (1 + slPercent / 100)
shortTP = strategy.position_avg_price * (1 - tpPercent / 100)

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", limit=longTP, stop=longSL)

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", limit=shortTP, stop=shortSL)

var box longBox = na
var box shortBox = na

if showZones and longCondition
    longBox := box.new(left=bar_index, top=close * (1 + tpPercent / 100), bottom=close * (1 - slPercent / 100), right=bar_index, bgcolor=color.new(#FFC0CB, 80), border_color=#FFC0CB, border_width=1)

if showZones and shortCondition
    shortBox := box.new(left=bar_index, top=close * (1 + slPercent / 100), bottom=close * (1 - tpPercent / 100), right=bar_index, bgcolor=color.new(color.black, 80), border_color=color.new(color.black, 30), border_width=1)

if showZones and strategy.position_size > 0 and not na(longBox)
    box.set_right(longBox, bar_index)

if showZones and strategy.position_size < 0 and not na(shortBox)
    box.set_right(shortBox, bar_index)

var line entryLine = na
var line slLine = na
var line tpLine = na
var label entryLabel = na
var label slLabel = na
var label tpLabel = na

if showLevels and (longCondition or shortCondition)
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tpLine)
    label.delete(entryLabel)
    label.delete(slLabel)
    label.delete(tpLabel)

if showLevels and longCondition
    epx = close
    slpx = close * (1 - slPercent / 100)
    tppx = close * (1 + tpPercent / 100)
    entryLine := line.new(bar_index, epx, bar_index, epx, color=color.blue, width=1)
    slLine := line.new(bar_index, slpx, bar_index, slpx, color=color.red, width=1)
    tpLine := line.new(bar_index, tppx, bar_index, tppx, color=color.green, width=1)
    entryLabel := label.new(bar_index, epx, "Entry: " + str.tostring(epx, "#.##"), style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.small)
    slLabel := label.new(bar_index, slpx, "SL: " + str.tostring(slpx, "#.##"), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    tpLabel := label.new(bar_index, tppx, "TP: " + str.tostring(tppx, "#.##"), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)

if showLevels and shortCondition
    epx = close
    slpx = close * (1 + slPercent / 100)
    tppx = close * (1 - tpPercent / 100)
    entryLine := line.new(bar_index, epx, bar_index, epx, color=color.blue, width=1)
    slLine := line.new(bar_index, slpx, bar_index, slpx, color=color.red, width=1)
    tpLine := line.new(bar_index, tppx, bar_index, tppx, color=color.green, width=1)
    entryLabel := label.new(bar_index, epx, "Entry: " + str.tostring(epx, "#.##"), style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.small)
    slLabel := label.new(bar_index, slpx, "SL: " + str.tostring(slpx, "#.##"), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    tpLabel := label.new(bar_index, tppx, "TP: " + str.tostring(tppx, "#.##"), style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)

if showLevels and strategy.position_size != 0
    if not na(entryLine)
        line.set_x2(entryLine, bar_index)
        label.set_x(entryLabel, bar_index)
    if not na(slLine)
        line.set_x2(slLine, bar_index)
        label.set_x(slLabel, bar_index)
    if not na(tpLine)
        line.set_x2(tpLine, bar_index)
        label.set_x(tpLabel, bar_index)

if showSignals and longCondition
    label.new(bar_index, low - atrVal * 0.5, "BUY", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if showSignals and shortCondition
    label.new(bar_index, high + atrVal * 0.5, "SELL", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

var float peakEquity = strategy.initial_capital
peakEquity := math.max(peakEquity, strategy.equity)
currentDDPct = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100 : 0.0
var float maxDDPct = 0.0
maxDDPct := math.max(maxDDPct, currentDDPct)

var int dailyWins = 0
var int dailyLosses = 0
var int lastClosedCount = 0
newDay = ta.change(time("D")) != 0

if newDay
    dailyWins := 0
    dailyLosses := 0

if strategy.closedtrades > lastClosedCount
    lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastProfit > 0
        dailyWins += 1
    else
        dailyLosses += 1
    lastClosedCount := strategy.closedtrades

totalTrades = strategy.closedtrades
wins = strategy.wintrades
losses = strategy.losstrades
winRate = totalTrades > 0 ? wins / totalTrades * 100 : 0.0

var table statsTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)

if showTable and barstate.islast
    table.cell(statsTable, 0, 0, "Win Rate", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statsTable, 1, 0, str.tostring(winRate, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statsTable, 0, 1, "Wins", text_color=color.white)
    table.cell(statsTable, 1, 1, str.tostring(wins), text_color=color.green)
    table.cell(statsTable, 0, 2, "Losses", text_color=color.white)
    table.cell(statsTable, 1, 2, str.tostring(losses), text_color=color.red)
    table.cell(statsTable, 0, 3, "Daily Win", text_color=color.white)
    table.cell(statsTable, 1, 3, str.tostring(dailyWins), text_color=color.green)
    table.cell(statsTable, 0, 4, "Daily Loss", text_color=color.white)
    table.cell(statsTable, 1, 4, str.tostring(dailyLosses), text_color=color.red)
    table.cell(statsTable, 0, 5, "Drawdown", text_color=color.white)
    table.cell(statsTable, 1, 5, str.tostring(maxDDPct, "#.##") + "%", text_color=color.orange)
